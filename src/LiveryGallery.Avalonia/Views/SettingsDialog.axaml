<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ForzaToolkit.UI;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:tk="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        xmlns:views="using:LiveryGallery.Views"
        x:Class="LiveryGallery.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Width="820" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Window.Styles>
        <!-- The page list on the left: rounded rows, the open page in the accent colour -->
        <Style Selector="TextBlock.storageDetail">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.storageDetail.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- A heading inside a page, and the small grey text under a setting -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- The game a setting belongs to: the open game's name beside the settings each game has its own -->
        <Style Selector="Border.gameChip">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.gameChip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconSettings}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="RequestClose">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <!-- Left: the pages -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16">
                    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="10,0,0,16" />
                    <ListBox x:Name="PageList" Classes="settingsPages" SelectionMode="Single,AlwaysSelected"
                             SelectionChanged="PageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:SettingsPageItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <!-- The hidden bold copy takes the space of the selected title: a name that wraps
                                         in bold wraps always, and the rows do not move when the selection changes -->
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Opacity="0" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: the open page, and the buttons under it -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,20,28,16">
                    <TextBlock x:Name="PageTitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <!-- A page whose every setting is the open game's own -->
                    <Border x:Name="PageGameChip" Classes="gameChip" Margin="10,0,0,0" IsVisible="False">
                        <TextBlock Text="{Binding GameName}" />
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="PageScroll"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Panel Margin="28,0,28,8">
                        <!-- Appearance: theme and language -->
                        <StackPanel x:Name="AppearancePage">
                            <TextBlock x:Name="ThemeSectionLabel" Classes="sectionLabel" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <RadioButton x:Name="SystemThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                                             IsChecked="{Binding IsSystemTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.System}" />
                                <RadioButton x:Name="LightThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                                             IsChecked="{Binding IsLightTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.Light}" />
                                <RadioButton x:Name="DarkThemeRadio" GroupName="ThemeGroup"
                                             IsChecked="{Binding IsDarkTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.Dark}" />
                            </StackPanel>

                            <!-- The cards: where their badges stand (applied when saved, no restart) -->
                            <TextBlock x:Name="CardsSectionLabel" Classes="sectionLabel" />
                            <ComboBox x:Name="BadgesPlaceCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding BadgesPlaceOptions}"
                                      SelectedItem="{Binding SelectedBadgesPlaceOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BadgesPlaceOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="BadgesPlaceHint" Classes="hint" Margin="0,4,0,24" TextWrapping="Wrap" />

                            <TextBlock x:Name="LanguageSectionLabel" Classes="sectionLabel" />
                            <ComboBox x:Name="LanguageCombo" Classes="modern" HorizontalAlignment="Stretch" Margin="0,0,0,24"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Car names, countries and car types: in a language of the game, taken from its files -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="CarTextLanguageSectionLabel" Classes="sectionLabel" Margin="0" />
                                <Border Classes="gameChip"><TextBlock Text="{Binding GameName}" /></Border>
                            </StackPanel>
                            <ComboBox x:Name="CarTextLanguageCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CarTextLanguageOptions}"
                                      SelectedItem="{Binding SelectedCarTextLanguageOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CarTextLanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="CarTextLanguageHintText" Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Folders: the game and the save -->
                        <StackPanel x:Name="FoldersPage" IsVisible="False">
                            <TextBlock x:Name="GamePathLabel" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <tk:GameFolderBox x:Name="GameFolderBox" Margin="0,0,0,20"
                                              Folder="{Binding GamePath}" FoundFolder="{Binding FoundGamePath}"
                                              Status="{Binding GameFolderStatusText}" StatusKind="{Binding GameFolderStatusKind}" />

                            <TextBlock x:Name="SavePathLabel" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="SavePathBox" Grid.Column="0" Classes="search" FontSize="13"
                                         Margin="0,0,8,0" Text="{Binding SavePath, Mode=TwoWay}" />
                                <Button x:Name="SaveBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                                        Content="..." Click="SaveBrowseButton_Click" />
                            </Grid>
                            <TextBlock x:Name="HintText" Classes="hint" Margin="0,10,0,0" />

                            <!-- The accounts of the game: found on this PC or added by hand; the switcher offers them all -->
                            <StackPanel x:Name="AccountsSection" IsVisible="False" Margin="0,28,0,0">
                                <TextBlock x:Name="AccountsSectionLabel" Classes="sectionLabel" />
                                <TextBlock x:Name="AccountsHint" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <ItemsControl x:Name="AccountsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountRowViewModel">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <PathIcon Grid.Column="0" Data="{StaticResource IconUser}" Width="16" Height="16"
                                                              Margin="0,0,10,0" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                            <TextBlock Text="{Binding Marker}" FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Border IsVisible="{Binding IsCurrent}" Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CurrentText}" FontSize="11" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SavePath}" FontSize="11" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SavePath}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="secondary" Padding="10,4" Margin="10,0,0,0"
                                                            VerticalAlignment="Center" Content="{Binding ForgetButtonText}"
                                                            IsVisible="{Binding CanForget}" Click="ForgetListedAccountButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- A new account: the place of its save, then "Add" -->
                                <Border x:Name="AddAccountRow" IsVisible="False" Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="AddAccountLabel" FontSize="12" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBox x:Name="AddAccountPathBox" Grid.Column="0" Classes="search" FontSize="13"
                                                     Margin="0,0,8,0" KeyDown="AddAccountPathBox_KeyDown" />
                                            <Button x:Name="AddAccountBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                                                    Margin="0,0,8,0" Content="..." Click="AddAccountBrowseButton_Click" />
                                            <Button x:Name="AddAccountConfirmButton" Grid.Column="2" Classes="primary"
                                                    Margin="0,0,8,0" Click="AddAccountConfirmButton_Click" />
                                            <Button x:Name="AddAccountCancelButton" Grid.Column="3" Classes="secondary"
                                                    Click="AddAccountCancelButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="AddAccountError" Classes="hint" Margin="0,6,0,0" IsVisible="False"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="AddAccountButton" Classes="secondary" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="12,6" Click="AddAccountButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <!-- A line glyph: drawn with a stroke, as the main window's "Add filter" (a PathIcon
                                             fills it and showed nothing) -->
                                        <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AddAccountButtonText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- The storage of each account: where it is (the program's folder or one of the user's), how big, and
                                 "Change folder…" (docs/storage.md, "Own folder") -->
                            <StackPanel x:Name="StorageSection" IsVisible="False" Margin="0,28,0,0">
                                <TextBlock x:Name="StorageSectionLabel" Classes="sectionLabel" />
                                <TextBlock x:Name="StorageHint" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <ItemsControl x:Name="StorageList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StorageRowViewModel">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <RadioButton Grid.Column="0" GroupName="StorageRows" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                            <Border IsVisible="{Binding IsCurrent}" Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CurrentText}" FontSize="11" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding PathText}" FontSize="11.5" Margin="0,2,0,0"
                                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Info.Folder}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Classes="storageDetail" Text="{Binding DetailText}" FontSize="11"
                                                                   Classes.danger="{Binding IsUnavailable}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="secondary" Padding="10,4" Margin="10,0,0,0"
                                                            VerticalAlignment="Center" Content="{Binding ChangeText}"
                                                            Click="ChangeStorageFolderButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="OpenStorageFolderButton" Classes="secondary" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="12,6" Click="OpenStorageFolderButton_Click" />
                                <!-- Flat (the default) or the folders as folders on disk: one choice for every storage, the files
                                     moved at once (docs/storage.md, "Folders on disk") -->
                                <CheckBox x:Name="StorageFoldersOnDiskCheckBox" Margin="0,16,0,2" IsVisible="False"
                                          Click="StorageFoldersOnDiskCheckBox_Click">
                                    <TextBlock x:Name="StorageFoldersOnDiskText" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock x:Name="StorageFoldersOnDiskHint" Classes="hint" TextWrapping="Wrap" Margin="28,0,0,0"
                                           IsVisible="{Binding #StorageFoldersOnDiskCheckBox.IsVisible}" />
                                <TextBlock x:Name="StorageFoldersOnDiskStatus" Classes="hint" TextWrapping="Wrap" Margin="28,4,0,0" IsVisible="False" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Gallery: scanning and duplicates -->
                        <StackPanel x:Name="GalleryPage" IsVisible="False">
                            <TextBlock x:Name="ScanningSectionLabel" Classes="sectionLabel" />
                            <CheckBox x:Name="AutoRefreshLiveriesCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoRefreshLiveries}" />
                            <CheckBox x:Name="RefreshOnButtonClickCheckBox" Margin="0,0,0,10" IsChecked="{Binding RefreshOnButtonClick}" />
                            <CheckBox x:Name="SearchByFolderNameCheckBox" Margin="0,0,0,10" IsChecked="{Binding SearchByFolderName}" />
                            <CheckBox x:Name="ShowChangesSinceLastLaunchCheckBox" Margin="0,0,0,10"
                                      IsChecked="{Binding ShowChangesSinceLastLaunch}" />
                            <!-- Scrolling with the mouse wheel pressed, in the liveries and the screenshots -->
                            <CheckBox x:Name="WheelClickScrollCheckBox" Margin="0,0,0,10" IsChecked="{Binding WheelClickScroll}" />
                            <TextBlock Text="{Binding WheelScrollSpeedText}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Slider x:Name="WheelScrollSpeedSlider" Margin="0,0,0,10" Minimum="50" Maximum="300" TickFrequency="25"
                                    IsSnapToTickEnabled="True" Value="{Binding WheelScrollSpeed, Mode=TwoWay}" />
                            <CheckBox x:Name="WarnFewFreeSlotsCheckBox" Margin="0,0,0,24" IsChecked="{Binding WarnFewFreeSlots}">
                                <!-- A long text in some languages: the plate goes to the next line instead of widening the page -->
                                <WrapPanel>
                                    <TextBlock x:Name="WarnFewFreeSlotsText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Classes="gameChip"><TextBlock Text="{Binding GameName}" /></Border>
                                </WrapPanel>
                            </CheckBox>

                            <!-- The screenshots of the liveries: the setting is every game's, the place they take the open game's -->
                            <TextBlock x:Name="ScreenshotsSectionLabel" Classes="sectionLabel" />
                            <RadioButton x:Name="ScreenshotsOriginalRadio" GroupName="ScreenshotsFormat" Margin="0,0,0,4"
                                         IsChecked="{Binding ScreenshotsKeepOriginal}" />
                            <RadioButton x:Name="ScreenshotsWebPRadio" GroupName="ScreenshotsFormat" Margin="0,0,0,4"
                                         IsChecked="{Binding ScreenshotsWebP}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,0,0,0" IsEnabled="{Binding ScreenshotsWebP}">
                                <TextBlock x:Name="ScreenshotsQualityLabel" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding ScreenshotsWebPQuality, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding ScreenshotsWebPQualityText}" MinWidth="40"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="ScreenshotsWebPHint" Classes="hint" Margin="28,2,0,10" TextWrapping="Wrap" />
                            <CheckBox x:Name="ScreenshotsInBackupsCheckBox" Margin="0,0,0,8" IsChecked="{Binding ScreenshotsInBackups}" />
                            <!-- The usage line above the buttons: side by side the long line in some languages went under them -->
                            <StackPanel x:Name="ScreenshotsUsageRow" Margin="0,0,0,24" Spacing="8" IsVisible="False">
                                <WrapPanel>
                                    <TextBlock x:Name="ScreenshotsUsageText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Classes="gameChip"><TextBlock Text="{Binding GameName}" /></Border>
                                </WrapPanel>
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button x:Name="ScreenshotsConvertButton" Classes="secondary" Click="ScreenshotsConvert_Click" />
                                    <Button x:Name="ScreenshotsFolderButton" Classes="secondary" Click="ScreenshotsFolder_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock x:Name="DuplicatesSectionLabel" Classes="sectionLabel" />
                            <TextBlock x:Name="PossibleDuplicateThresholdLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider x:Name="PossibleDuplicateThresholdSlider" Grid.Column="0"
                                        Minimum="{Binding MinPossibleDuplicateThreshold}" Maximum="{Binding MaxPossibleDuplicateThreshold}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        Value="{Binding PossibleDuplicateThreshold, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding PossibleDuplicateThresholdText}" MinWidth="44"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="PossibleDuplicateThresholdHint" Classes="hint" Margin="0,2,0,24" />

                            <TextBlock x:Name="UpdatesSectionLabel" Classes="sectionLabel" />
                            <TextBlock x:Name="UpdateInstallLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <ComboBox x:Name="UpdateInstallCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding UpdateInstallOptions}"
                                      SelectedItem="{Binding SelectedUpdateInstallOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UpdateInstallOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="UpdateInstallHint" Classes="hint" Margin="0,4,0,12" TextWrapping="Wrap" />
                            <CheckBox x:Name="BetaUpdatesCheckBox" IsChecked="{Binding BetaUpdates}" />
                            <TextBlock x:Name="BetaUpdatesHint" Classes="hint" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Backups: what the gallery backs up on its own, and how many it keeps -->
                        <StackPanel x:Name="BackupsPage" IsVisible="False">
                            <TextBlock x:Name="AutoBackupSectionLabel" Classes="sectionLabel" />
                            <CheckBox x:Name="AutoBackupBeforeArchiveCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoBackupBeforeArchive}" />
                            <CheckBox x:Name="AutoBackupOnChangeCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoBackupOnChange}" />
                            <CheckBox x:Name="AutoBackupPeriodicCheckBox" Margin="0,0,0,4" IsChecked="{Binding AutoBackupPeriodic}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20" IsEnabled="{Binding AutoBackupPeriodic}">
                                <Slider Grid.Column="0" Minimum="{Binding MinAutoBackupPeriodDays}" Maximum="{Binding MaxAutoBackupPeriodDays}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding AutoBackupPeriodDays, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding AutoBackupPeriodText}" MinWidth="64"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="AutoBackupKeepLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0" Minimum="{Binding MinAutoBackupKeep}" Maximum="{Binding MaxAutoBackupKeep}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding AutoBackupKeep, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding AutoBackupKeepText}" MinWidth="64"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="AutoBackupHint" Classes="hint" Margin="0,6,0,24" />

                            <!-- The archive's questions: "do not ask again" in them turns them off, here they come back -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="ArchiveWarningsSectionLabel" Classes="sectionLabel" Margin="0" />
                                <Border Classes="gameChip"><TextBlock Text="{Binding GameName}" /></Border>
                            </StackPanel>
                            <CheckBox x:Name="WarnArchiveWithoutInstalledDataCheckBox" Margin="0,0,0,10"
                                      IsChecked="{Binding WarnArchiveWithoutInstalledData}" />
                            <CheckBox x:Name="WarnArchiveWithOutdatedInstalledDataCheckBox" Margin="0,0,0,4"
                                      IsChecked="{Binding WarnArchiveWithOutdatedInstalledData}" />
                            <TextBlock x:Name="ArchiveWarningsHint" Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Find in game: the rows of the in-game list and the key interval -->
                        <StackPanel x:Name="FindInGamePage" IsVisible="False">
                            <TextBlock x:Name="NavigationRowsLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <ComboBox x:Name="NavigationRowsCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RowsModeOptions}"
                                      SelectedItem="{Binding SelectedRowsModeOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RowsModeOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="NavigationRowsStatusText" Classes="hint" Margin="0,4,0,12"
                                       Text="{Binding RowsStatusText}"
                                       IsVisible="{Binding RowsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <!-- Liveries the game keeps on its servers: first in the grid, before the save's -->
                            <TextBlock x:Name="ServerLiveriesLabel" FontSize="13" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <ComboBox x:Name="ServerLiveriesCombo" Classes="modern" MinWidth="96" HorizontalAlignment="Left"
                                      ItemsSource="{Binding ServerLiveriesOptions}"
                                      SelectedItem="{Binding ServerLiveries, Mode=TwoWay}" />
                            <TextBlock x:Name="ServerLiveriesHint" Classes="hint" Margin="0,4,0,12" TextWrapping="Wrap" />
                            <TextBlock x:Name="NavigationKeyIntervalLabel" FontSize="13" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider x:Name="NavigationKeyIntervalSlider" Grid.Column="0"
                                        Minimum="{Binding MinKeyInterval}" Maximum="{Binding MaxKeyInterval}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding KeyInterval, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding KeyIntervalText}" MinWidth="56"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="NavigationKeyIntervalHint" Classes="hint" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Server: the connection and what it sends -->
                        <StackPanel x:Name="ServerPage" IsVisible="False">
                            <CheckBox x:Name="ServerConnectionCheckBox" IsChecked="{Binding ServerConnectionEnabled}"
                                      IsCheckedChanged="ServerConnectionCheckBox_IsCheckedChanged" />
                            <TextBlock x:Name="ServerConnectionDescription" Classes="hint" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Data: stored accounts and the diagnostics export -->
                        <StackPanel x:Name="DataPage" IsVisible="False">
                            <StackPanel x:Name="AccountDataSection" IsVisible="False" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="AccountDataSectionLabel" Classes="sectionLabel" Margin="0" />
                                    <Border Classes="gameChip"><TextBlock Text="{Binding GameName}" /></Border>
                                </StackPanel>
                                <TextBlock x:Name="AccountDataHint" Classes="hint" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding StoredAccounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StoredAccountRowViewModel">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       IsVisible="{Binding !IsGone}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       IsVisible="{Binding IsGone}"
                                                                       Foreground="{DynamicResource WarningBrush}" />
                                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="secondary" Padding="10,4" VerticalAlignment="Center"
                                                            Content="{Binding ForgetButtonText}"
                                                            IsVisible="{Binding CanForget}" Click="ForgetAccountButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="DiagnosticsSection">
                                <TextBlock x:Name="DiagnosticsSectionLabel" Classes="sectionLabel" />
                                <TextBlock x:Name="DiagnosticsHint" Classes="hint" Margin="0,0,0,10" />
                                <Button x:Name="ExportDiagnosticsButton" Classes="secondary" HorizontalAlignment="Left" MinWidth="180"
                                        Click="ExportDiagnosticsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,24">
                    <Button x:Name="ExitButton" Classes="secondary" MinWidth="120" Margin="0,0,10,0" Click="ExitButton_Click" />
                    <Button x:Name="SaveButton" Classes="primary" MinWidth="120" IsEnabled="{Binding IsDirty}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
