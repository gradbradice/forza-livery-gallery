<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:coll="using:LiveryGallery.Views.Collections"
        xmlns:models="clr-namespace:LiveryGallery.Models"
        xmlns:enums="clr-namespace:LiveryGallery.Enums"
        xmlns:gallery="using:ForzaToolkit.Liveries.Gallery"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        xmlns:svc="clr-namespace:LiveryGallery.Services"
        xmlns:views="clr-namespace:LiveryGallery.Views"
        xmlns:services="clr-namespace:LiveryGallery.Services"
        xmlns:ui="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:input="clr-namespace:ForzaToolkit.UI.Input;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:updates="clr-namespace:ForzaToolkit.UI.Updates;assembly=ForzaToolkit.UI.Avalonia.Updates"
        x:Class="LiveryGallery.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://LiveryGallery.Avalonia/Assets/app-icon.png"
        Height="860" Width="1320" MinHeight="560" MinWidth="960"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        views:CardBadges.AtBottom="{Binding BadgesAtBottom}">

    <Window.DataTemplates>
        <!-- A tooltip with the key of its action (ShortcutTip): the text, and the key right of it -->
        <DataTemplate DataType="services:ShortcutTip" x:DataType="services:ShortcutTip">
            <DockPanel>
                <Border DockPanel.Dock="Right" Classes="keyCap" Margin="12,1,0,0">
                    <TextBlock Text="{Binding Gesture}" />
                </Border>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <!-- The context menu of the cards: one for all of them, given to the card it is asked on (Card_ContextRequested).
             In each card it was 28 items with their icons and theme styles: most of a card's weight in memory, and
             every livery a card showed while scrolling went through all of their bindings -->
        <ContextMenu x:Key="LiveryCardMenu" x:DataType="vm:LiveryEntry">
            <MenuItem Header="{DynamicResource Loc_ContextMenuOpenDetails}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.OpenDetailsCommand}"
                      CommandParameter="{Binding}"
                      views:ShortcutHint.Action="OpenDetails">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPreview}" Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <!-- The card's 3D button shows the livery in the window used last; this one opens one more, to compare (a window
                 for each selected livery when there are several) -->
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.View3DNewWindowMenuHeader}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.View3DNewWindowCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding CanView3D}"
                      views:ShortcutHint.Action="View3DNewWindow"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="{Binding View3DTooltip}">
                <MenuItem.Icon>
                    <ui:GridIcon Data="{StaticResource Icon3D}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!-- The context menu selects its card first: these three work on every selected livery -->
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.FavoriteMenuHeader}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ToggleFavoritesCommand}"
                      CommandParameter="{Binding}"
                      views:ShortcutHint.Action="Favorite">
                <MenuItem.Icon>
                    <ui:FavoriteStar Width="16" Height="16" StrokeThickness="1.4"
                                     IsOn="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.FavoriteMenuRemoves}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.LockMenuHeader}"
                      IsVisible="{Binding ShowLockButton}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ToggleLocksCommand}"
                      CommandParameter="{Binding}"
                      views:ShortcutHint.Action="Lock">
                <MenuItem.Icon>
                    <Panel>
                        <ui:GridIcon Data="{StaticResource IconLock}" StrokeThickness="2" Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).Gallery.LockMenuRemoves}" />
                        <ui:GridIcon Data="{StaticResource IconLockOpen}" StrokeThickness="2" Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.LockMenuRemoves}" />
                    </Panel>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.EditTagsMenuHeader}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.EditTagsCommand}"
                      CommandParameter="{Binding}"
                      views:ShortcutHint.Action="Tags">
                <MenuItem.Icon>
                    <ui:GridIcon Data="{StaticResource IconBookmark}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc_ContextMenuOnlyThisCar}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ShowOnlyCarCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{DynamicResource Loc_ContextMenuOnlyThisManufacturer}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ShowOnlyManufacturerCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{DynamicResource Loc_ContextMenuOnlyThisAuthor}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ShowOnlyAuthorCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{DynamicResource Loc_ContextMenuOnlyThisCountry}"
                      IsVisible="{Binding HasCarCountry}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ShowOnlyCountryCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFlag}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_ContextMenuOnlyThisCarType}"
                      IsVisible="{Binding HasCarType}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ShowOnlyCarTypeCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCarSide}" Width="13" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_ContextMenuClearQuickFilters}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.ClearQuickFiltersCommand}"
                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterBar.HasQuickFilters}" />
            <Separator IsVisible="{Binding ShowFindInGame}" />
            <MenuItem Header="{DynamicResource Loc_ContextMenuNavigateInGame}"
                      IsVisible="{Binding ShowFindInGame}"
                      views:ShortcutHint.Action="FindInGame"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateInGameCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateInGameMenuBlockedTooltip}">
                <MenuItem.Icon>
                    <ui:GridIcon Data="{StaticResource IconLocate}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.AssignAuthorMenuVisible}" />
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.AssignAuthorMenuHeader}"
                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.AssignAuthorMenuVisible}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.AssignAuthorCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.UnassignAuthorMenuHeader}"
                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.UnassignAuthorMenuVisible}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.UnassignAuthorCommand}"
                      CommandParameter="{Binding}" />
            <Separator />
            <!-- In the storage: Ins back into the game, Del to the archive -->
            <MenuItem Header="{DynamicResource Loc_ContextMenuReturnToGame}"
                      IsVisible="{Binding IsStored}"
                      views:ShortcutHint.Action="ReturnToGame"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReturnSelectedToGameCommand}">
                <MenuItem.Icon>
                    <ui:GridIcon Data="{StaticResource IconToGame}" StrokeThickness="2" Foreground="{DynamicResource StorageTextBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <!-- Filled when the menu opens: no folder, the storage's folders, "New folder…" -->
            <MenuItem Header="{DynamicResource Loc_ContextMenuMoveToFolder}" Tag="moveToFolder"
                      IsVisible="{Binding IsStored}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolder}" Width="13" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_ContextMenuMoveToArchive}"
                      IsVisible="{Binding IsStored}"
                      views:ShortcutHint.Action="StoredToArchive"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveSelectedToArchiveCommand}" />
            <!-- In the game. Del: kept beyond the game's limit; Shift+Del: to the archive, to delete -->
            <MenuItem Header="{DynamicResource Loc_ContextMenuMoveToStorage}"
                      IsVisible="{Binding !IsStored}"
                      views:ShortcutHint.Action="MoveToStorage"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveSelectedToStorageCommand}"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).StorageBlockedTooltip}" />
            <MenuItem Header="{DynamicResource Loc_ContextMenuMoveToArchive}"
                      IsVisible="{Binding !IsStored}"
                      views:ShortcutHint.Action="MoveToArchive"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveSelectedToArchiveCommand}"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).ArchiveBlockedTooltip}" />
        </ContextMenu>

        <DataTemplate x:Key="LiveryCardTemplate" x:DataType="vm:LiveryEntry">
            <Border Classes="liveryCard" Width="270" Margin="8"
                    Classes.selected="{Binding IsSelected}"
                    Classes.current="{Binding IsCurrent}"
                    views:ThumbnailRows.Track="True"
                    PointerPressed="Card_SelectPointerPressed"
                    PointerMoved="Card_PointerMoved"
                    PointerReleased="Card_PointerReleased"
                    DoubleTapped="Card_DoubleTapped"
                    ContextRequested="Card_ContextRequested">
                <StackPanel>
                    <Border Height="26" Padding="14,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding LiveryIdText}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding HasGamePosition}"
                                        Background="Transparent"
                                        ToolTip.Tip="{Binding GamePositionTooltip}">
                                <Path Data="{StaticResource IconLocate}" Width="10" Height="10" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding GamePositionText}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Height="150" ClipToBounds="True">
                        <Border CornerRadius="0" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                       IsVisible="{Binding ShowThumbnailImage}"
                                       ToolTip.Tip="{Binding ThumbnailTooltip}" />
                                <Border Background="{DynamicResource ThumbnailPlaceholderBrush}"
                                        IsVisible="{Binding !ShowThumbnailImage}">
                                    <Path Data="{StaticResource IconCarSide}" Width="34" Height="34" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{DynamicResource ThumbnailPlaceholderTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- On the picture (the setting's default): what the livery is over its top, where else it is and how its
                             file was read over its bottom, as far as the cover's way back to the game's preview and the
                             screenshots' count; badges that do not fit go into "+N". Under the selection's shade like the
                             picture. All of them are 24 high, their icons 16 in the middle (the toolkit's 24 grid) -->
                        <views:CardBadges Group="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom" Margin="8">
                            <views:CardBadges Group="Bottom" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <!-- A screenshot is the cover: one click puts the game's preview back -->
                                <Button Classes="coverReset" IsVisible="{Binding HasCover}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestorePreviewCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{x:Static loc:Strings.ScreenshotRestorePreview}">
                                    <Border>
                                        <ui:GridIcon Data="{StaticResource IconReset}" Width="16" Height="16" StrokeThickness="2.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                    </Border>
                                </Button>
                                <!-- The user's screenshots of the livery: a pill of 24, the camera in its first circle, the count -->
                                <Border IsVisible="{Binding HasScreenshots}" Background="#B0000000"
                                        Height="24" MinWidth="24" CornerRadius="12"
                                        ToolTip.Tip="{Binding ScreenshotCountTooltip}">
                                    <Grid ColumnDefinitions="24,Auto" Height="24">
                                        <ui:GridIcon Data="{StaticResource IconCamera}" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                        <TextBlock Grid.Column="1" Text="{Binding ScreenshotCountText}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="0" Background="#4D000000"
                                IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                        <Border Classes="selectMark" Width="40" Height="40" CornerRadius="20"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsSelected}" IsHitTestVisible="False">
                            <Path Data="{StaticResource IconCheck}" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="White" />
                        </Border>
                    </Grid>
                    <!-- The round buttons. The icons (the toolkit's 24 grid) take their size, 18 in the middle of the button of 28,
                         and their pen from the style of Button.cardIconButton.
                         Seven fit in a row without touching (28 + 6 each: 232 of the card's 238), so one more can come -->
                    <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Classes="cardIconButton"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.EditTagsCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{DynamicResource Loc_EditTagsTooltip}">
                                <ui:GridIcon Data="{StaticResource IconBookmark}" />
                            </Button>

                            <!-- The big preview: hidden for now (the livery window shows the picture), kept for a while -->
                            <Button Classes="cardIconButton" IsVisible="False"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ViewPreviewCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{DynamicResource Loc_ViewPreviewTooltip}">
                                <Path Data="{StaticResource IconPreview}" Fill="{DynamicResource TextPrimaryBrush}" />
                            </Button>

                            <Button Classes="cardIconButton view3d"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.View3DCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanView3D}"
                                    ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="{Binding View3DTooltip, Converter={x:Static views:ShortcutTipConverter.Instance}, ConverterParameter={x:Static services:GalleryShortcut.View3D}}">
                                <ui:GridIcon Data="{StaticResource Icon3D}" />
                            </Button>

                            <!-- A stored livery: back into the game, in the storage's colour -->
                            <Button Classes="cardIconButton toGame"
                                    IsVisible="{Binding IsStored}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReturnToGameOneCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{DynamicResource Loc_ReturnToGameTooltip}">
                                <ui:GridIcon Classes="line" Data="{StaticResource IconToGame}" Foreground="White" />
                            </Button>

                            <Button Classes="cardIconButton"
                                    IsVisible="{Binding HasFindInGameButton}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateInGameCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanNavigateInGame}"
                                    ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="{Binding NavigateInGameTooltip, Converter={x:Static views:ShortcutTipConverter.Instance}, ConverterParameter={x:Static services:GalleryShortcut.FindInGame}}">
                                <ui:GridIcon Data="{StaticResource IconLocate}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                            <!-- The note's mark: its text in the tooltip, a click opens the livery window -->
                            <Button Classes="cardIconButton"
                                    IsVisible="{Binding HasNote}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.OpenDetailsCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding NoteTooltip}">
                                <ui:GridIcon Classes="line note" Data="{StaticResource IconNote}" />
                            </Button>

                            <!-- The lock: open and outlined while the livery may go to the archive, closed and in the
                                 accent colour (the button too) while it is locked -->
                            <Button Classes="cardIconButton"
                                    Classes.locked="{Binding IsLocked}"
                                    IsVisible="{Binding ShowLockButton}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ToggleLockCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding LockTooltip, Converter={x:Static views:ShortcutTipConverter.Instance}, ConverterParameter={x:Static services:GalleryShortcut.Lock}}">
                                <Panel>
                                    <ui:GridIcon Classes="line" Data="{StaticResource IconLockOpen}" IsVisible="{Binding !IsLocked}" />
                                    <ui:GridIcon Classes="line" Data="{StaticResource IconLock}" Foreground="White" IsVisible="{Binding IsLocked}" />
                                </Panel>
                            </Button>

                            <!-- The toolkit's star of a favourite: an outline, gold when on (the same in every app) -->
                            <Button Classes="cardIconButton"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{DynamicResource Loc_FavoriteToggleTooltip}">
                                <ui:FavoriteStar IsOn="{Binding IsFavorite}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- The lines under the buttons: one gap between any two of them (the panel's spacing, no margins of
                         their own), and the icons of the lines in one column (Border.cardMetaIcon) -->
                    <StackPanel Margin="14,10,14,14" Spacing="6">
                        <TextBlock Text="{Binding LiveryName}" FontSize="14.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding LiveryName}" />
                        <!-- A left-aligned grid: the model column hugs its text and gives way (with an ellipsis) only when the
                             row does not fit the card, so the year stays right after the model and never leaves the card -->
                        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left">
                            <!-- The make in plain text, a step quieter than the model: a plate is the user's tag or a badge -->
                            <TextBlock Text="{Binding CarManufacturer}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="110"
                                       ToolTip.Tip="{Binding CarManufacturer}" />
                            <TextBlock Grid.Column="1" Text="{Binding CarModelName}" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding CarModelName}" />
                            <TextBlock Grid.Column="2" Text="{Binding CarYear, StringFormat=({0})}" FontSize="11.5" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- The make's country and the car's group in the game, in the chosen language of car names -->
                        <!-- The row is narrower than both texts at their longest ("Великобритания" + "Героические кроссоверы"):
                             the country keeps up to 110 px, the car type takes what is left and ends with an ellipsis
                             instead of running past the card's edge (the full text is in the tooltip) -->
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Left" IsVisible="{Binding HasCarDetails}">
                            <DockPanel IsVisible="{Binding HasCarCountry}" Margin="0,0,12,0"
                                       Background="Transparent" ToolTip.Tip="{Binding CarCountryTooltip}">
                                <Border Classes="cardMetaIcon" DockPanel.Dock="Left"><Path Data="{StaticResource IconFlag}" /></Border>
                                <TextBlock Text="{Binding CarCountry}" FontSize="12" MaxWidth="110"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" IsVisible="{Binding HasCarType}"
                                       Background="Transparent" ToolTip.Tip="{Binding CarTypeTooltip}">
                                <Border Classes="cardMetaIcon" DockPanel.Dock="Left"><Path Data="{StaticResource IconCarSide}" /></Border>
                                <TextBlock Text="{Binding CarType}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                        </Grid>

                        <!-- The hover highlight: square, from the icon to 3 px past the end of the line (so its edge does
                             not touch the round warning mark) and 2 px above
                             and below the text. The negative margin keeps the row where it was -->
                        <Button Classes="rowLink" Padding="0,2,3,2" Margin="0,-2,-3,-2" CornerRadius="0"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ShowAuthorRowCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding AuthorTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Classes="cardMetaIcon"><Path Data="{StaticResource IconUser}" /></Border>
                                <TextBlock Text="{Binding AuthorDisplayText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="184" />
                                <!-- An edited header's id, or hints nobody answered yet: the tooltip says which -->
                                <Border IsVisible="{Binding ShowAuthorWarning}"
                                        Width="14" Height="14" CornerRadius="7" Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource WarningBrush}">
                                    <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip.Tip="{Binding DateTooltip}">
                            <Border Classes="cardMetaIcon"><Path Data="{StaticResource IconCalendarDay}" /></Border>
                            <TextBlock Text="{Binding DateDisplay}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- The badges at the bottom of the card (a setting; on the picture by default): both groups in lines
                             of 20, hidden when there is none (an empty row would still take the gap above it) -->
                        <views:CardBadges Group="All" Below="True" />

                        <!-- Hidden without tags: an empty row would still take the gap above it -->
                        <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="tagChipCard"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ToggleTagCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   Foreground="{DynamicResource ChipTextBrush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The folder's name can be selected with the mouse and copied with Ctrl+C (GalleryClicks.FolderNameClass):
                             a press on it selects text, not the card, and a double click takes the word, not the livery
                             window. No menu of its own: a right click gives the card's, as anywhere on the card. The
                             transparent background makes all of its rectangle take the pointer, between the letters too -->
                        <SelectableTextBlock Classes="cardFolderName" Text="{Binding FolderName}" FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                   ContextFlyout="{x:Null}" Background="Transparent"
                                   IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowFolderNames}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GalleryRowTemplate" x:DataType="models:GalleryRow">
            <Border Classes="galleryRow" Classes.last="{Binding IsLastInGroup}"
                    Width="{Binding Group.GroupWidth}" HorizontalAlignment="Center">
                <views:GalleryRowPresenter ItemTemplate="{StaticResource LiveryCardTemplate}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="vm:LiveryGroup">
            <ToggleButton Classes="groupHeader" Width="{Binding GroupWidth}" HorizontalAlignment="Center"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" Click="GroupHeader_Click">
                <StackPanel Orientation="Horizontal">
						<ui:FavoriteStar IsOn="True" Width="17" Height="17" StrokeThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsFavoritesGroup}" />
                    <PathIcon Data="{StaticResource IconUser}" Width="13" Height="13"
                          Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsMineGroup}" />
                    <Path Data="{StaticResource IconCircleFilled}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{DynamicResource AuctionBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsAuctionGroup}" />
                    <TextBlock Text="{Binding Key}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CountText}" FontSize="13" Margin="7,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

						<StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsVisible="{Binding HasFavorites}"
                                VerticalAlignment="Center">
							<ui:FavoriteStar IsOn="True" Width="15" Height="15" StrokeThickness="1.2" Margin="0,0,4,0" />
							<TextBlock Text="{Binding FavoriteCount}" FontSize="13"
									   Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsVisible="{Binding HasMine}"
                                VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconUser}" Width="10" Height="10"
                              Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding MineCount}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsVisible="{Binding HasDuplicates}"
                                VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCircleFilled}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource DangerBrush}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding DuplicateCount}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsVisible="{Binding HasPossibleDuplicates}"
                                VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCircleFilled}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource WarningBrush}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding PossibleDuplicateCount}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Classes="groupOnly" Margin="12,0,0,0" VerticalAlignment="Center"
                            IsVisible="{Binding HasGroupFilter}" Click="GroupShowOnlyButton_Click"
                            ToolTip.Tip="{DynamicResource Loc_GroupShowOnlyTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource IconFilter}" Width="11" Height="11" />
                            <TextBlock Text="{DynamicResource Loc_GroupShowOnlyButton}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <DataTemplate x:Key="TagChipTemplate" x:DataType="vm:TagChipViewModel">
            <!-- A click shows only the tag's liveries, a right click hides them -->
            <Button Classes="tagChip" Classes.shown="{Binding IsShown}" Classes.hidden="{Binding IsHidden}" Margin="0,0,8,8"
                    Command="{Binding ToggleShowCommand}" PointerReleased="TagChip_PointerReleased"
                    ToolTip.Tip="{DynamicResource Loc_TagChipTooltip}">
                <TextBlock Text="{Binding Tag}" Foreground="{Binding $parent[Button].Foreground}" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" x:Name="CustomTitleBar" Background="{DynamicResource ToolbarBrush}"
                Height="36" PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Path Data="{StaticResource IconFlag}" Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CustomTitleBarText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <!-- The game shown, as a chip: its menu has every game the program supports -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <Button x:Name="GameButton" Padding="10,0" Height="26"
                        VerticalAlignment="Center" CornerRadius="7" BorderThickness="1"
                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                        Click="GameButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="GameButtonText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <!-- As high as the triangle itself (the glyph is 10 x 5): in a square box it was drawn at the
                             box's top and stood 2 px above the middle of the name -->
                        <Path Data="{StaticResource IconChevronDown}" Width="9" Height="4.5" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- "Game 238 / 1000 | Storage 1 450" (docs/storage.md): the half shown in its colour, Ctrl+1 and Ctrl+2 -->
                <Border x:Name="ModeSwitch" Height="28" Padding="2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Center"
                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="GameModeButton" Classes="modeHalf" Classes.on="{Binding IsGameMode}"
                                Command="{Binding ShowGameCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="GameModeText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Classes="modeCount" Text="{Binding GameCountText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StorageModeButton" Classes="modeHalf storage" Classes.on="{Binding IsStorageMode}"
                                Command="{Binding ShowStorageCommand}" IsEnabled="{Binding HasStorage}"
                                ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconStorage}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                <TextBlock x:Name="StorageModeText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Classes="modeCount" Text="{Binding StorageCountText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                </StackPanel>
                <!-- The storage is shown: a line of its colour along the title bar -->
                <Border Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource StorageBrush}"
                        IsVisible="{Binding IsStorageMode}" IsHitTestVisible="False" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="MinimizeButtonEl" Classes="titlebar" Click="MinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButtonEl" Classes="titlebar" Click="MaximizeButton_Click">
                        <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButtonEl" Classes="titlebar close" Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Classes="search" x:DataType="vm:FilterBarViewModel"
                             DataContext="{Binding FilterBar}"
                             Margin="0,0,10,0" Text="{Binding SearchText, Mode=TwoWay}"
                             TextChanged="SearchBox_TextChanged" />
					<StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Liveries or their screenshots: two halves of one switch -->
                    <Border x:Name="ViewSwitch" Margin="0,0,8,0" Height="38" Padding="3" CornerRadius="10" BorderThickness="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="LiveriesViewButton" Classes="viewHalf on" Click="LiveriesView_Click" />
                            <Button x:Name="ScreenshotsViewButton" Classes="viewHalf" Click="ScreenshotsView_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconCamera}" Width="17" Height="13" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ScreenshotsViewText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- The account shown: its name and the end of its XUID. The menu has the game's other accounts -->
                    <Button x:Name="AccountSwitcherButton" Margin="0,0,8,0" MaxWidth="360" Height="38" Padding="12,0"
                            VerticalAlignment="Center" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                            IsVisible="{Binding HasMultipleAccounts}" IsEnabled="{Binding CanSwitchAccount}"
                            ToolTip.Tip="{x:Static loc:Strings.AccountSwitcherTooltip}" Click="AccountSwitcherButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconUser}" Width="15" Height="15" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedAccount.Name}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedAccount.Marker}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Path Data="{StaticResource IconChevronDown}" Width="10" Height="5" Stretch="Uniform" Margin="2,0,0,0"
                                  Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- The sets of filters saved for this game: its menu is kept built (MainWindow.FilterPresets.cs) -->
                    <Button x:Name="FilterPresetsButton" Classes="icon" Margin="0,0,8,0"
                            ToolTip.Tip="{x:Static loc:Strings.FilterPresetsTooltip}">
                        <ui:GridIcon Data="{StaticResource IconLayers}" Width="20" Height="20" StrokeThickness="2"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>
					<Button x:Name="DisplayFilterButton" Classes="icon" Margin="0,0,8,0"
                            DataContext="{Binding FilterBar}"
                            ToolTip.Tip="{x:Static loc:Strings.DisplayFilterTooltip}">
						    <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16"
								      Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" x:DataType="vm:FilterBarViewModel">
                                <MenuItem IsHitTestVisible="False" Focusable="False">
                                    <MenuItem.Header>
                                        <TextBlock x:Name="FilterMenuTitleText" FontWeight="SemiBold" Margin="0,2,0,4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="SortMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <Border Classes="menuBadgeSpace" />
                                            <TextBlock Grid.Column="1" x:Name="SortLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SortValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="SortManufacturerItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsChecked="{Binding IsSortManufacturer}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.Manufacture}" />
                                    <MenuItem x:Name="SortAuthorItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsChecked="{Binding IsSortAuthor}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.Author}" />
                                    <MenuItem x:Name="SortCountryItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsChecked="{Binding IsSortCountry}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.Country}" />
                                    <MenuItem x:Name="SortCarTypeItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsChecked="{Binding IsSortCarType}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.CarType}" />
                                    <MenuItem x:Name="SortDownloadTimeItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsChecked="{Binding IsSortDownloadTime}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.DownloadTime}" />
                                    <MenuItem x:Name="SortGameOrderItem" ToggleType="Radio" GroupName="SortGroup"
                                              IsVisible="{Binding ShowGameOrderSort}"
                                              IsChecked="{Binding IsSortGameOrder}"
                                              Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static gallery:SortMode.GameOrder}" />
                                </MenuItem>
                                <MenuItem x:Name="GroupingMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <Border Classes="menuBadgeSpace" />
                                            <TextBlock Grid.Column="1" x:Name="GroupingLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GroupingValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="GroupingNoneItem" ToggleType="Radio" GroupName="GroupingGroup"
                                              IsChecked="{Binding IsGroupingNone}"
                                              Command="{Binding DisableGroupingCommand}" />
                                    <MenuItem x:Name="GroupingByKeyItem" ToggleType="Radio" GroupName="GroupingGroup"
                                              Header="{Binding GroupingByKeyText}" IsChecked="{Binding IsGroupingByKey}"
                                              Command="{Binding EnableGroupingCommand}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="FavMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <Panel><ui:FavoriteStar IsOn="True" Width="18" Height="18" StrokeThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center" /></Panel>
                                            <TextBlock Grid.Column="1" x:Name="FavLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding FavoriteValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="FavNoneItem" ToggleType="Radio" GroupName="FavGroup"
                                              IsChecked="{Binding IsFavNone}"
                                              Command="{Binding SetFavoriteModeCommand}" CommandParameter="{x:Static gallery:FavoriteMode.None}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="FavNoneItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="FavFirstItem" ToggleType="Radio" GroupName="FavGroup"
                                              IsChecked="{Binding IsFavFirst}"
                                              Command="{Binding SetFavoriteModeCommand}" CommandParameter="{x:Static gallery:FavoriteMode.FavoritesFirst}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Panel Classes="menuStar">
                                                        <ui:FavoriteStar IsOn="True" Width="15" Height="15" StrokeThickness="1.2" />
                                                    </Panel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="FavFirstItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="FavOnlyItem" ToggleType="Radio" GroupName="FavGroup"
                                              IsChecked="{Binding IsFavOnly}"
                                              Command="{Binding SetFavoriteModeCommand}" CommandParameter="{x:Static gallery:FavoriteMode.OnlyFavorites}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Panel Classes="menuStar">
                                                        <ui:FavoriteStar IsOn="True" Width="15" Height="15" StrokeThickness="1.2" />
                                                    </Panel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="FavOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="FavSeparateItem" Classes="separateOption" ToggleType="Radio" GroupName="FavGroup"
                                              IsChecked="{Binding IsFavSeparate}" IsEnabled="{Binding IsFavSeparateEnabled}"
                                              Command="{Binding SetFavoriteModeCommand}" CommandParameter="{x:Static gallery:FavoriteMode.FavoritesSeparately}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Panel Classes="menuStar">
                                                        <ui:FavoriteStar IsOn="True" Width="15" Height="15" StrokeThickness="1.2" />
                                                    </Panel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="FavSeparateItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="InstalledMenuItem" IsEnabled="{Binding IsInstalledFilterAvailable}" IsVisible="{Binding ShowInstalledFilter}"
                                          ToolTip.Tip="{Binding InstalledMenuTooltip}" ToolTip.ShowOnDisabled="True">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="Installed" />
                                            <TextBlock Grid.Column="1" x:Name="InstalledLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding InstalledValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="InstalledNoneItem" ToggleType="Radio" GroupName="InstalledGroup"
                                              IsChecked="{Binding IsInstalledNone}"
                                              Command="{Binding SetInstalledModeCommand}" CommandParameter="{x:Static gallery:InstalledMode.None}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="InstalledNoneItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InstalledFirstItem" ToggleType="Radio" GroupName="InstalledGroup"
                                              IsChecked="{Binding IsInstalledFirst}"
                                              Command="{Binding SetInstalledModeCommand}" CommandParameter="{x:Static gallery:InstalledMode.InstalledFirst}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Installed" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="InstalledFirstItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InstalledOnlyItem" ToggleType="Radio" GroupName="InstalledGroup"
                                              IsChecked="{Binding IsInstalledOnly}"
                                              Command="{Binding SetInstalledModeCommand}" CommandParameter="{x:Static gallery:InstalledMode.OnlyInstalled}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Installed" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="InstalledOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <!-- The other way round: the liveries no car uses -->
                                    <MenuItem x:Name="NotInstalledFirstItem" ToggleType="Radio" GroupName="InstalledGroup"
                                              IsChecked="{Binding IsNotInstalledFirst}"
                                              Command="{Binding SetInstalledModeCommand}" CommandParameter="{x:Static gallery:InstalledMode.NotInstalledFirst}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Installed" Crossed="True" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="NotInstalledFirstItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="NotInstalledOnlyItem" ToggleType="Radio" GroupName="InstalledGroup"
                                              IsChecked="{Binding IsNotInstalledOnly}"
                                              Command="{Binding SetInstalledModeCommand}" CommandParameter="{x:Static gallery:InstalledMode.OnlyNotInstalled}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Installed" Crossed="True" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="NotInstalledOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="MineMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="Mine" />
                                            <TextBlock Grid.Column="1" x:Name="MineLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding MineValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="MineNoneItem" ToggleType="Radio" GroupName="MineGroup"
                                              IsChecked="{Binding IsMineNone}"
                                              Command="{Binding SetMineModeCommand}" CommandParameter="{x:Static gallery:MineMode.None}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="MineNoneItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="MineFirstItem" ToggleType="Radio" GroupName="MineGroup"
                                              IsChecked="{Binding IsMineFirst}"
                                              Command="{Binding SetMineModeCommand}" CommandParameter="{x:Static gallery:MineMode.MineFirst}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Mine" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="MineFirstItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="MineOnlyItem" ToggleType="Radio" GroupName="MineGroup"
                                              IsChecked="{Binding IsMineOnly}"
                                              Command="{Binding SetMineModeCommand}" CommandParameter="{x:Static gallery:MineMode.OnlyMine}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Mine" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="MineOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="MineSeparateItem" Classes="separateOption" ToggleType="Radio" GroupName="MineGroup"
                                              IsChecked="{Binding IsMineSeparate}" IsEnabled="{Binding IsMineSeparateEnabled}"
                                              Command="{Binding SetMineModeCommand}" CommandParameter="{x:Static gallery:MineMode.MineSeparately}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Mine" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="MineSeparateItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="DupMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="Duplicate" />
                                            <TextBlock Grid.Column="1" x:Name="DupLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DuplicatesValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="DupAllItem" ToggleType="Radio" GroupName="DupGroup"
                                              IsChecked="{Binding IsDupAll}"
                                              Command="{Binding SetDuplicatesFilterModeCommand}" CommandParameter="{x:Static gallery:DuplicatesFilterMode.All}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <TextBlock Grid.Column="1" x:Name="DupAllItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="DupAndPossibleItem" ToggleType="Radio" GroupName="DupGroup"
                                              IsChecked="{Binding IsDupAndPossible}"
                                              Command="{Binding SetDuplicatesFilterModeCommand}" CommandParameter="{x:Static gallery:DuplicatesFilterMode.DuplicatesAndPossible}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgePair Classes="menuBadge" First="Duplicate" Second="PossibleDuplicate" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="DupAndPossibleItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="DupOnlyItem" ToggleType="Radio" GroupName="DupGroup"
                                              IsChecked="{Binding IsDupOnly}"
                                              Command="{Binding SetDuplicatesFilterModeCommand}" CommandParameter="{x:Static gallery:DuplicatesFilterMode.DuplicatesOnly}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Duplicate" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="DupOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="GenMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="Generated" />
                                            <TextBlock Grid.Column="1" x:Name="GenLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GeneratedValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="GenAllItem" ToggleType="Radio" GroupName="GenGroup"
                                              IsChecked="{Binding IsGenAll}"
                                              Command="{Binding SetGeneratedFilterModeCommand}" CommandParameter="{x:Static gallery:GeneratedFilterMode.All}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="GenAllItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="GenOnlyItem" ToggleType="Radio" GroupName="GenGroup"
                                              IsChecked="{Binding IsGenOnly}"
                                              Command="{Binding SetGeneratedFilterModeCommand}" CommandParameter="{x:Static gallery:GeneratedFilterMode.GeneratedOnly}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Generated" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="GenOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <!-- The other place: "In the storage" while the game is shown, "In the game" while the storage is -->
                                <MenuItem x:Name="CopiesMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="{Binding CopyBadge}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CopiesLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding CopiesValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="CopiesAllItem" ToggleType="Radio" GroupName="CopiesGroup"
                                              IsChecked="{Binding IsCopiesAll}"
                                              Command="{Binding SetCopiesFilterModeCommand}" CommandParameter="{x:Static svc:CopiesFilterMode.All}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <TextBlock Grid.Column="1" x:Name="CopiesAllItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem ToggleType="Radio" GroupName="CopiesGroup"
                                              IsChecked="{Binding IsCopiesSame}"
                                              Command="{Binding SetCopiesFilterModeCommand}" CommandParameter="{x:Static svc:CopiesFilterMode.Same}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="{Binding CopyBadge}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="CopiesSameItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem ToggleType="Radio" GroupName="CopiesGroup"
                                              IsChecked="{Binding IsCopiesSameOrSimilar}"
                                              Command="{Binding SetCopiesFilterModeCommand}" CommandParameter="{x:Static svc:CopiesFilterMode.SameOrSimilar}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgePair Classes="menuBadge" First="{Binding CopyBadge}" Second="{Binding SimilarBadge}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="CopiesSameOrSimilarItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem ToggleType="Radio" GroupName="CopiesGroup"
                                              IsChecked="{Binding IsCopiesSimilar}"
                                              Command="{Binding SetCopiesFilterModeCommand}" CommandParameter="{x:Static svc:CopiesFilterMode.Similar}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="{Binding SimilarBadge}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="CopiesSimilarItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem ToggleType="Radio" GroupName="CopiesGroup"
                                              IsChecked="{Binding IsCopiesNone}"
                                              Command="{Binding SetCopiesFilterModeCommand}" CommandParameter="{x:Static svc:CopiesFilterMode.None}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="45,Auto">
                                                <TextBlock Grid.Column="1" x:Name="CopiesNoneItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="PaintMenuItem">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="PaintOnly" />
                                            <TextBlock Grid.Column="1" x:Name="PaintLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding PaintValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="PaintAllItem" ToggleType="Radio" GroupName="PaintGroup"
                                              IsChecked="{Binding IsPaintAll}"
                                              Command="{Binding SetPaintFilterModeCommand}" CommandParameter="{x:Static gallery:PaintFilterMode.All}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="PaintAllItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="PaintOnlyItem" ToggleType="Radio" GroupName="PaintGroup"
                                              IsChecked="{Binding IsPaintOnly}"
                                              Command="{Binding SetPaintFilterModeCommand}" CommandParameter="{x:Static gallery:PaintFilterMode.PaintOnly}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="PaintOnly" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="PaintOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="PaintHideItem" ToggleType="Radio" GroupName="PaintGroup"
                                              IsChecked="{Binding IsPaintHidden}"
                                              Command="{Binding SetPaintFilterModeCommand}" CommandParameter="{x:Static gallery:PaintFilterMode.HidePaint}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="PaintHideItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem x:Name="AuctionMenuItem" IsVisible="{Binding ShowAuctionFilter}">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="240">
                                            <views:BadgeChip Classes="menuBadge" Badge="Auction" />
                                            <TextBlock Grid.Column="1" x:Name="AuctionLabelText" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AuctionValueText}" Margin="24,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="AuctionAllItem" ToggleType="Radio" GroupName="AuctionGroup"
                                              IsChecked="{Binding IsAuctionAll}"
                                              Command="{Binding SetAuctionFilterModeCommand}" CommandParameter="{x:Static gallery:AuctionFilterMode.All}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="AuctionAllItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="AuctionOnlyItem" ToggleType="Radio" GroupName="AuctionGroup"
                                              IsChecked="{Binding IsAuctionOnly}"
                                              Command="{Binding SetAuctionFilterModeCommand}" CommandParameter="{x:Static gallery:AuctionFilterMode.OnlyAuction}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Auction" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="AuctionOnlyItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="AuctionSeparateItem" ToggleType="Radio" GroupName="AuctionGroup"
                                              IsChecked="{Binding IsAuctionSeparate}" IsEnabled="{Binding IsAuctionSeparateEnabled}"
                                              Command="{Binding SetAuctionFilterModeCommand}" CommandParameter="{x:Static gallery:AuctionFilterMode.AuctionSeparately}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <views:BadgeChip Classes="menuBadge" Badge="Auction" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="AuctionSeparateItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="AuctionHideItem" ToggleType="Radio" GroupName="AuctionGroup"
                                              IsChecked="{Binding IsAuctionHidden}"
                                              Command="{Binding SetAuctionFilterModeCommand}" CommandParameter="{x:Static gallery:AuctionFilterMode.HideAuction}">
                                        <MenuItem.Header>
                                            <Grid Classes="menuChoice" ColumnDefinitions="26,Auto">
                                                <TextBlock Grid.Column="1" x:Name="AuctionHideItemText" VerticalAlignment="Center" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="AddQuickFilterButton" Classes="toolbarText" Margin="0,0,8,0"
                            x:DataType="vm:QuickFilterPickerViewModel" DataContext="{Binding QuickFilterPicker}"
                            ToolTip.Tip="{DynamicResource Loc_QuickFilterAddTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                            <TextBlock x:Name="AddQuickFilterLabel" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    Opening="QuickFilterPickerFlyout_Opening" Opened="QuickFilterPickerFlyout_Opened">
                                <StackPanel Width="380" Spacing="10" Margin="4" x:DataType="vm:QuickFilterPickerViewModel">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                        <ToggleButton Classes="tagChip" Content="{DynamicResource Loc_QuickFilterKindManufacturer}"
                                                      IsChecked="{Binding IsManufacturerKind, Mode=TwoWay}" />
                                        <ToggleButton Classes="tagChip" Content="{DynamicResource Loc_QuickFilterKindCar}"
                                                      IsChecked="{Binding IsCarKind, Mode=TwoWay}" />
                                        <ToggleButton Classes="tagChip" Content="{DynamicResource Loc_QuickFilterKindAuthor}"
                                                      IsChecked="{Binding IsAuthorKind, Mode=TwoWay}" />
                                        <ToggleButton Classes="tagChip" Content="{DynamicResource Loc_QuickFilterKindCountry}"
                                                      IsChecked="{Binding IsCountryKind, Mode=TwoWay}" />
                                        <ToggleButton Classes="tagChip" Content="{DynamicResource Loc_QuickFilterKindCarType}"
                                                      IsChecked="{Binding IsCarTypeKind, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <TextBox x:Name="QuickFilterSearchBox" Classes="search"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Loc_QuickFilterSearchWatermark}"
                                             KeyDown="QuickFilterSearchBox_KeyDown" />
                                    <TextBlock Text="{Binding CarScopeText}" IsVisible="{Binding HasCarScope}"
                                               FontSize="12" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Panel>
                                        <ListBox x:Name="QuickFilterOptionsList" ItemsSource="{Binding Options}" MaxHeight="380"
                                                 SelectionMode="Single" Tapped="QuickFilterOptionsList_Tapped"
                                                 KeyDown="QuickFilterOptionsList_KeyDown"
                                                 Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QuickFilterOption">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{DynamicResource Loc_QuickFilterPickerEmpty}" IsVisible="{Binding HasNoOptions}"
                                                   Margin="4,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Panel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
					</StackPanel>

					<Button x:Name="RefreshButton" Grid.Column="2" Classes="icon" Margin="0,0,8,0" x:DataType="vm:MainViewModel"
                            IsEnabled="{Binding Status.CanRefresh}" Command="{Binding RefreshCommand}">
						<PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"
								  Foreground="{DynamicResource TextPrimaryBrush}" />
					</Button>

					<Button x:Name="AuthorsButton" Grid.Column="3" Classes="icon" Margin="0,0,8,0"
                            Click="AuthorsButton_Click">
						<PathIcon Data="{StaticResource IconUser}" Width="16" Height="16"
								  Foreground="{DynamicResource TextPrimaryBrush}" />
					</Button>

					<Button x:Name="StatsButton" Grid.Column="4" Classes="icon" Margin="0,0,8,0"
							Click="StatsButton_Click">
						<PathIcon Data="{StaticResource IconStats}" Width="16" Height="16"
								  Foreground="{DynamicResource TextPrimaryBrush}" />
					</Button>

					<Button x:Name="SettingsButton" Grid.Column="5" Classes="icon">
						<PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"
								  Foreground="{DynamicResource TextPrimaryBrush}" />
						<Button.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem x:Name="FreeSpaceMenuItem" Click="FreeSpaceMenuItem_Click" />
								<MenuItem x:Name="OpenArchiveMenuItem" Click="OpenArchiveMenuItem_Click" views:ShortcutHint.Action="Archive" />
								<MenuItem x:Name="OpenBackupsMenuItem" Click="OpenBackupsMenuItem_Click" views:ShortcutHint.Action="Backups" />
								<MenuItem x:Name="OpenSettingsMenuItem" Click="OpenSettingsMenuItem_Click" views:ShortcutHint.Action="Settings" />
								<Separator />
								<MenuItem x:Name="ShortcutsMenuItem" Click="ShortcutsMenuItem_Click" views:ShortcutHint.Action="ShortcutList" />
								<MenuItem x:Name="ContactsMenuItem" Click="ContactsMenuItem_Click" />
								<MenuItem x:Name="AboutMenuItem" Click="AboutMenuItem_Click" />
							</MenuFlyout>
						</Button.Flyout>
                    </Button>
                </Grid>
                <Grid x:Name="TagsFilterRow" Margin="0,12,0,0" ColumnDefinitions="Auto,*" x:DataType="vm:TagsBarViewModel"
                      DataContext="{Binding TagsBar}" IsVisible="{Binding HasTags}">
                    <TextBlock Grid.Column="0" x:Name="TagsFilterLabel" FontSize="12" Margin="0,5,10,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl Grid.Column="1" x:Name="TagsBar" ItemsSource="{Binding AllTags}" ItemTemplate="{StaticResource TagChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
                <Grid x:Name="QuickFiltersRow" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto" x:DataType="vm:FilterBarViewModel"
                      DataContext="{Binding FilterBar}" IsVisible="{Binding HasFilterChips}">
                    <TextBlock Grid.Column="0" x:Name="QuickFiltersLabel" FontSize="12" Margin="0,5,10,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <!-- One row for everything that hides liveries now: the "only …" filters of the filter menu (filled
                         chips), then the quick filters, a car or an author (outlined chips). Each chip's cross takes its
                         filter off -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding FilterChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="vm:ModeFilterChipViewModel">
                                <Button Classes="filterChipFilled" Margin="0,0,8,8" Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="{DynamicResource Loc_QuickFilterRemoveTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        <Path Data="{StaticResource IconCross}" Width="8" Height="8" Stretch="Uniform"
                                              Stroke="White" StrokeThickness="1.6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:QuickFilterChipViewModel">
                                <Button Classes="filterChipOutlined" Margin="0,0,8,8"
                                        Command="{Binding $parent[ItemsControl].((vm:FilterBarViewModel)DataContext).RemoveQuickFilterCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{DynamicResource Loc_QuickFilterRemoveTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        <Path Data="{StaticResource IconCross}" Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <!-- Every filter off at once (the search too). Always at the row's right end, on its first line: it
                         does not move as chips come and go or wrap -->
                    <Button Grid.Column="2" x:Name="ResetFiltersButton" Classes="filterChipReset" Margin="8,0,0,8"
                            VerticalAlignment="Top" Command="{Binding ResetFiltersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:GridIcon Data="{StaticResource IconReset}" Width="14" Height="14" StrokeThickness="2"
                                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static loc:Strings.ResetFiltersTooltip}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource BgBrush}" Padding="20,10" x:DataType="vm:GalleryStatusViewModel"
                DataContext="{Binding Status}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The room in the save, "238 / 1000": yellow from 90 %, red at the limit; a click opens "free up room" -->
                <Button x:Name="SlotsCounter" Grid.Column="4" Classes="rowLink slots" Margin="14,0,0,0" VerticalAlignment="Center"
                        x:DataType="vm:MainViewModel" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}"
                        IsVisible="{Binding ShowSlotsCounter}" ToolTip.Tip="{Binding SlotsTooltip}"
                        Classes.warning="{Binding IsSlotsWarning}" Classes.full="{Binding IsSlotsFull}"
                        Click="SlotsCounter_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Ellipse Classes="slotsDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock Classes="slotsText" Text="{Binding SlotsText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- The storage instead of the room: how many it holds, and its keys -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center"
                            x:DataType="vm:MainViewModel" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}"
                            IsVisible="{Binding IsStorageMode}">
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Path Data="{StaticResource IconStorage}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{DynamicResource StorageTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock Text="{Binding StorageStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource StorageTextBrush}" />
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding StorageKeysHint}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <!-- The last action can be undone (MainViewModel.Undo.cs): shown until the next one. Ctrl+Z does the same -->
                    <Button x:Name="UndoButton" Classes="rowLink" Margin="10,0,0,0" VerticalAlignment="Center"
                            x:DataType="vm:MainViewModel" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}"
                            IsVisible="{Binding CanUndo}" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTooltip}">
                        <TextBlock Text="{DynamicResource Loc_UndoLabel}" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                    <StackPanel x:Name="SelectionPanel" Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.HasSelection}">
                        <TextBlock Text="·" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.SelectionSummaryText}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Classes="rowLink" Margin="10,0,0,0"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Gallery.ClearSelectionCommand}"
                                ToolTip.Tip="{DynamicResource Loc_ClearSelectionTip}">
                            <TextBlock Text="{DynamicResource Loc_ClearSelectionLabel}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ServerStatusIndicator" Grid.Column="1" Classes="rowLink" Margin="0,0,14,0"
                        x:DataType="vm:ServerStatusViewModel"
                        DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).ServerStatus}"
                        IsVisible="{Binding IsVisible}" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Tooltip}" Click="ServerStatusIndicator_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="serverDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Classes.green="{Binding IsGreen}" Classes.yellow="{Binding IsYellow}"
                                 Classes.blue="{Binding IsBlue}" Classes.red="{Binding IsRed}" Classes.gray="{Binding IsGray}" />
                        <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateBanner" Grid.Column="2" Classes="pill" x:DataType="updates:AppUpdateBanner"
                        DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).UpdateBanner}"
                        Margin="0,0,12,0" Padding="10,4" FontSize="11.5" IsVisible="{Binding IsVisible}"
                        Click="UpdateBanner_Click">
                    <TextBlock x:Name="UpdateBannerText" Text="{Binding Text}" />
                </Button>
                <StackPanel x:Name="CountPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CountBaseText" Text="{Binding CountText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <StackPanel x:Name="FavoritesCountPanel" Orientation="Horizontal" Margin="10,0,0,0"
                                IsVisible="{Binding HasFavorites}" VerticalAlignment="Center">
                        <TextBlock Text="·" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ui:FavoriteStar IsOn="True" Width="15" Height="15" StrokeThickness="1.2" Margin="0,0,4,0" />
                        <TextBlock x:Name="FavoritesCountText" Text="{Binding FavoritesCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="DuplicatesCountPanel" Orientation="Horizontal" Margin="10,0,0,0"
                                IsVisible="{Binding HasDuplicates}" VerticalAlignment="Center">
                        <TextBlock Text="·" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Path Data="{StaticResource IconCircleFilled}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource DangerBrush}" Margin="0,0,5,0" />
                        <TextBlock x:Name="DuplicatesCountText" Text="{Binding DuplicatesCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="PossibleDuplicatesCountPanel" Orientation="Horizontal" Margin="10,0,0,0"
                                IsVisible="{Binding HasPossibleDuplicates}" VerticalAlignment="Center">
                        <TextBlock Text="·" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Path Data="{StaticResource IconCircleFilled}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource WarningBrush}" Margin="0,0,5,0" />
                        <TextBlock x:Name="PossibleDuplicatesCountText" Text="{Binding PossibleDuplicatesCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="GalleryHost" Grid.Row="3" Background="{DynamicResource BgBrush}" x:DataType="vm:GalleryStatusViewModel"
              DataContext="{Binding Status}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
            <!-- The storage's folders (docs/storage.md, stage 4): shown with the storage's liveries -->
            <coll:CollectionSidebar x:Name="StorageSidebar" Grid.RowSpan="2" Classes="storage" IsVisible="False" />
            <!-- Liveries put into the storage's folder by hand were found (docs/storage.md, "Own folder") -->
            <Border x:Name="StorageFoundBanner" Grid.Column="1" Margin="12,10,12,4" Padding="12,8" CornerRadius="8" BorderThickness="1"
                    x:DataType="vm:MainViewModel" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}"
                    IsVisible="{Binding ShowStorageFound}"
                    Background="{DynamicResource StorageSoftBrush}" BorderBrush="{DynamicResource StorageBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Data="{StaticResource IconStorage}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{DynamicResource StorageTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StorageFoundText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="StorageFoundDetailsButton" Grid.Column="2" Classes="secondary" Padding="10,4" Margin="12,0,6,0"
                            VerticalAlignment="Center" Click="StorageFoundDetails_Click" />
                    <Button Grid.Column="3" Classes="rowLink" VerticalAlignment="Center" Padding="4"
                            Command="{Binding CloseStorageFoundCommand}">
                        <Path Data="{StaticResource IconCross}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer x:Name="GalleryScroll" Grid.Column="1" Grid.Row="1" Padding="12,0,12,20" Focusable="True" FocusAdorner="{x:Null}"
                          input:MiddleButtonScroll.IsEnabled="True">
                <views:VirtualGalleryPanel x:Name="GalleryPanel"
                                           HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                                           RowTemplate="{StaticResource GalleryRowTemplate}" />
            </ScrollViewer>
            <!-- The rectangle dragged over the cards to select them (MainWindow.Band.cs): drawn over the list, takes no pointer -->
            <Canvas x:Name="BandLayer" Grid.Column="1" Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False">
                <Border x:Name="BandRect" IsVisible="False" BorderThickness="1" CornerRadius="2"
                        BorderBrush="{DynamicResource AccentBrush}">
                    <Border Background="{DynamicResource AccentBrush}" Opacity="0.16" />
                </Border>
            </Canvas>

            <StackPanel x:Name="EmptyState" Grid.Column="1" Grid.Row="1" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmptyStateVisible}">
                <Path Data="{StaticResource IconPalette}" Width="42" Height="42" Stretch="Uniform"
                      HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="EmptyStateText" Text="{Binding EmptyStateText}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <!-- The game's save was not found: the user may choose its folder, or let the gallery look again -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0" HorizontalAlignment="Center"
                            IsVisible="{Binding IsSaveMissing}">
                    <Button x:Name="ChooseSaveFolderButton" Classes="accent" Click="ChooseSaveFolderButton_Click" />
                    <Button x:Name="SearchSaveAgainButton" Click="SearchSaveAgainButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- "Screenshots": every screenshot of the liveries the filters and the search show, the newest first -->
            <!-- The screenshots of the liveries shown: albums on the left, the grouping and the order on top, then the groups.
                 A click selects (Ctrl, Shift as on the cards), a double click opens the viewer, a drag puts them in an album -->
            <Grid x:Name="ScreenshotsView" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource BgBrush}" ColumnDefinitions="Auto,*">
                <coll:CollectionSidebar x:Name="AlbumsSidebar" />
                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <DockPanel Margin="20,12,20,6">
                        <ComboBox x:Name="ScreenshotsOrderBox" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="ScreenshotsOrder_Changed" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="ScreenshotsGroupLabel" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Height="34" Padding="3" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="GroupByLiveryButton" Classes="viewHalf compact" Tag="ByLivery" Click="ScreenshotsGroup_Click" />
                                    <Button x:Name="GroupLikeLiveriesButton" Classes="viewHalf compact" Tag="LikeLiveries" Click="ScreenshotsGroup_Click" />
                                    <Button x:Name="GroupByDateButton" Classes="viewHalf compact" Tag="ByDate" Click="ScreenshotsGroup_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="ScreenshotsScroll" Grid.Row="1" Padding="20,4,20,20" HorizontalScrollBarVisibility="Disabled"
                                  input:MiddleButtonScroll.IsEnabled="True">
                        <ItemsControl x:Name="ScreenshotGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScreenshotGroupViewModel">
                                    <StackPanel Margin="0,0,0,12">
                                        <coll:CollectionGroupHeader Folded="ScreenshotGroup_Folded" LinkClicked="ScreenshotGroup_LinkClicked" />
                                        <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ScreenshotTile">
                                                    <Border Classes="shotTile" Classes.selected="{Binding IsSelected}" Classes.current="{Binding IsCurrent}" Width="300" Margin="0,0,14,14"
                                                            Background="Transparent" Cursor="Hand" ToolTip.Tip="{Binding Screenshot.FileName}"
                                                            PointerPressed="ShotTile_PointerPressed" PointerMoved="ShotTile_PointerMoved"
                                                            PointerReleased="ShotTile_PointerReleased" DoubleTapped="ShotTile_DoubleTapped"
                                                            ContextRequested="ShotTile_ContextRequested">
                                                        <StackPanel Spacing="5">
                                                            <Panel>
                                                                <Border x:Name="Picture" Height="169" CornerRadius="8" ClipToBounds="True"
                                                                        Background="{DynamicResource ThumbnailPlaceholderBrush}">
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <Border Classes="shotFrame" CornerRadius="8" />
                                                                <Border IsVisible="{Binding IsCover}" Background="#B0000000" CornerRadius="6" Padding="7,2"
                                                                        Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                    <TextBlock Text="{x:Static loc:Strings.ScreenshotCoverBadge}" FontSize="10.5"
                                                                               FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                            </Panel>
                                                            <TextBlock Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="ScreenshotsEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="False" MaxWidth="460">
                        <Path Data="{StaticResource IconCamera}" Width="50" Height="37" Stretch="Uniform"
                              HorizontalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ScreenshotsEmptyText" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- The storage's folder of its own is not there (a disk not plugged in): nothing of it is shown, nothing taken for gone -->
            <Border x:Name="StorageUnavailableView" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource BgBrush}"
                    x:DataType="vm:MainViewModel" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext)}"
                    IsVisible="{Binding ShowStorageUnavailable}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Path Data="{StaticResource IconStorage}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock x:Name="StorageUnavailableTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding StorageUnavailablePath}" FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="StorageUnavailableText" FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="StorageCheckAgainButton" Classes="secondary" Command="{Binding CheckStorageAgainCommand}" />
                        <Button x:Name="StorageChooseOtherButton" Classes="secondary" Click="StorageChooseOther_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource BgBrush}" Opacity="0.85" IsVisible="{Binding IsLoading}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconRefresh}" Width="30" Height="30" Stretch="Uniform"
                          HorizontalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="LoadingText" Text="{Binding LoadingText}" FontSize="13" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
