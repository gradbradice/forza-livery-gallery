<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:views="clr-namespace:LiveryGallery.Views"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        x:Class="LiveryGallery.Views.ArchiveDialog"
        x:DataType="vm:ArchiveViewModel"
        Width="560" Height="640" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="ArchivedLiveryRowTemplate" x:DataType="vm:ArchivedLiveryRowViewModel">
            <views:LiveryRow />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <!-- Liveries an earlier version archived without the account: put with this one when the user says so -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            IsVisible="{Binding HasUnassigned}">
                    <TextBlock Text="{Binding UnassignedText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="TakeUnassignedButton" FontSize="12.5" Command="{Binding TakeUnassignedCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            IsVisible="{Binding CanFilterByAccount}">
                    <TextBlock Text="{Binding HiddenByAccountText}" IsVisible="{Binding HasHiddenByAccount}"
                               FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Content="{x:Static loc:Strings.AccountFilterOnlyCurrent}" FontSize="12.5"
                              IsChecked="{Binding OnlyCurrentAccount, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Classes="search" FontSize="13" Margin="0,0,0,12"
                     IsVisible="{Binding HasAnyRows}" PlaceholderText="{Binding SearchPlaceholder}"
                     Text="{Binding SearchText, Mode=TwoWay}" />

            <Grid Grid.Row="2" Margin="0,0,0,10" IsVisible="{Binding !ShowEmptyState}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static loc:Strings.ArchiveSelectAllButton}" Classes="secondary" Padding="10,4"
                            Command="{Binding SelectAllCommand}" />
                    <Button Content="{x:Static loc:Strings.ClearSelectionLabel}" Classes="secondary" Padding="10,4"
                            Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <ScrollViewer Grid.Row="3" Classes="edge" IsVisible="{Binding !ShowEmptyState}">
                <ItemsControl Classes="rowList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ArchivedLiveryRowTemplate}" />
            </ScrollViewer>

            <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       IsVisible="{Binding ShowEmptyState}" Text="{Binding EmptyStateText}" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,14,0,0">
                <Button x:Name="DeleteButton" Classes="danger" MinWidth="140"
                        Command="{Binding RequestDeleteCommand}" />
                <!-- Kept for good instead of deleted: into the account's storage, the save untouched -->
                <Button x:Name="ToStorageButton" Classes="secondary" MinWidth="140" IsVisible="{Binding HasStorage}"
                        IsEnabled="{Binding HasSelection}" Command="{Binding MoveSelectedToStorageCommand}" />
                <Button x:Name="RestoreButton" Classes="primary" MinWidth="140"
                        Command="{Binding RestoreSelectedCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
