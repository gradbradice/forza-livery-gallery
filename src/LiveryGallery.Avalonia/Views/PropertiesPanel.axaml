<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LiveryGallery.Localisation"
             xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
             xmlns:views="clr-namespace:LiveryGallery.Views"
             xmlns:svc="clr-namespace:LiveryGallery.Services"
             xmlns:ui="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
             x:Class="LiveryGallery.Views.PropertiesPanel"
             x:DataType="vm:PropertiesViewModel">
    <!-- The properties panel (docs/plans.md, «Панель свойств»): the selected livery, or what the selected ones share -->
    <Border Classes="propertiesPanel">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,10,8,6">
                <TextBlock Text="{x:Static loc:Strings.PropertiesTitle}" Classes="propHeader" FontSize="13.5" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="1" Classes="noticeIconButton" Click="CloseButton_Click"
                        ToolTip.Tip="{x:Static loc:Strings.PropertiesClose}" AutomationProperties.Name="{x:Static loc:Strings.PropertiesClose}">
                    <Path Data="{StaticResource IconCross}" Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.6"
                          StrokeLineCap="Round" Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,4,16,20" Spacing="16">
                    <!-- Nothing selected -->
                    <TextBlock x:Name="EmptyText" IsVisible="{Binding IsEmpty}" Text="{x:Static loc:Strings.PropertiesEmpty}" TextWrapping="Wrap"
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />

                    <!-- One livery: its picture (the card's), name, car and author -->
                    <StackPanel IsVisible="{Binding IsSingle}" Spacing="4">
                        <Border DataContext="{Binding Single}">
                            <Border x:Name="Picture" x:DataType="vm:LiveryEntry" Height="172" CornerRadius="10" ClipToBounds="True"
                                    Background="{DynamicResource ThumbnailPlaceholderBrush}" views:ThumbnailRows.Track="True">
                                <Panel>
                                    <Border Background="{Binding PlaceholderTint, FallbackValue={x:Null}}" />
                                    <Image Source="{Binding Thumbnail, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                        </Border>
                        <!-- The name and the livery's number (as on its card) -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock x:Name="NameText" Text="{Binding Single.LiveryName, FallbackValue=''}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="NumberText" Grid.Column="1" Text="{Binding Single.LiveryIdText, FallbackValue=''}" FontSize="13"
                                       FontWeight="SemiBold" Margin="10,1,0,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <!-- The car, then a line each for its country, its type and the author, with the card's icons -->
                        <TextBlock x:Name="CarText" Text="{Binding Single.CarTitle, FallbackValue=''}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid x:Name="CarFacts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                            <Path Grid.Row="0" Data="{StaticResource IconFlag}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"
                                  IsVisible="{Binding Single.HasCarCountry, FallbackValue=False}" />
                            <TextBlock x:Name="CountryText" Grid.Row="0" Grid.Column="1" Text="{Binding Single.CarCountry, FallbackValue=''}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding Single.HasCarCountry, FallbackValue=False}" />
                            <Path Grid.Row="1" Data="{StaticResource IconCarSide}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                  VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}"
                                  IsVisible="{Binding Single.HasCarType, FallbackValue=False}" />
                            <TextBlock x:Name="TypeText" Grid.Row="1" Grid.Column="1" Text="{Binding Single.CarType, FallbackValue=''}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding Single.HasCarType, FallbackValue=False}" />
                            <!-- The author's name is the button to the author's card, as on the card -->
                            <Button x:Name="AuthorButton" Grid.Row="2" Grid.ColumnSpan="2" Classes="rowLink" Padding="0,2,4,2" Margin="0,0,-4,0"
                                    Command="{Binding ShowAuthorCommand}" ToolTip.Tip="{Binding Single.AuthorTooltip, FallbackValue=''}"
                                    AutomationProperties.Name="{Binding Single.AuthorDisplayText, FallbackValue=''}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                                          VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="AuthorText" Grid.Column="1" Text="{Binding Single.AuthorDisplayText, FallbackValue=''}"
                                               FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" IsVisible="{Binding Single.ShowAuthorWarning, FallbackValue=False}" Width="14" Height="14"
                                            CornerRadius="7" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource WarningBrush}">
                                        <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Several: how many, which cars, how many authors -->
                    <StackPanel IsVisible="{Binding IsMulti}" Spacing="4">
                        <TextBlock x:Name="MultiTitleText" Text="{Binding MultiTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MultiSummary}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Round buttons, as on the card and in the livery window. Their icons are 18: an even box in the 30
                         inside the border, so the same whole pixels on each side (17 stood 7 from the left, 8 from the right).
                         The gallery's actions offered here
                         (GalleryActions.Panel, their names and keys in the tooltips) on the left; the lock and the star on
                         the right, filled when every selected livery has it ("2 of 5" in the tooltip when some have) -->
                    <Grid x:Name="ButtonRow" ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEmpty}">
                        <ItemsControl x:Name="ActionList" ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- No spacing of its own: a hidden action leaves no gap, the buttons' margins space them -->
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GalleryAction">
                                    <Button Classes="roundIcon" Margin="0,0,6,6" Classes.toGame="{Binding IsToGame}" Command="{Binding Command}"
                                            IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding ShortLabel}">
                                        <views:ActionGlyph Action="{Binding}" Size="18" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Top">
                            <Button x:Name="LockButton" Classes="roundIcon" Classes.locked="{Binding AllLocked}" Command="{Binding ToggleLockCommand}"
                                    IsVisible="{Binding !IsStorageMode}" ToolTip.Tip="{Binding LockTooltip}"
                                    AutomationProperties.Name="{x:Static loc:Strings.PropertiesLock}">
                                <Panel Width="18" Height="18">
                                    <ui:GridIcon Data="{StaticResource IconLockOpen}" StrokeThickness="2" IsVisible="{Binding !AllLocked}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ui:GridIcon Data="{StaticResource IconLock}" StrokeThickness="2" IsVisible="{Binding AllLocked}"
                                                 Foreground="White" />
                                </Panel>
                            </Button>
                            <Button x:Name="FavoriteButton" Classes="roundIcon" Command="{Binding ToggleFavoriteCommand}"
                                    ToolTip.Tip="{Binding FavoriteTooltip}" AutomationProperties.Name="{x:Static loc:Strings.PropertiesFavorite}">
                                <ui:FavoriteStar IsOn="{Binding AllFavorite}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tags: the editor the livery window has too (TagEditor) -->
                    <Panel IsVisible="{Binding !IsEmpty}">
                        <views:TagEditor x:Name="TagEditor" DataContext="{Binding TagEditor}" />
                    </Panel>

                    <!-- The note of one livery, saved as it is typed -->
                    <StackPanel IsVisible="{Binding IsSingle}" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static loc:Strings.PropertiesNote}" Classes="propHeader" />
                            <TextBlock Text="{x:Static loc:Strings.PropertiesNoteSavesItself}" Classes="propPart" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="NoteBox" Text="{Binding Note.Text}" MaxLength="{Binding Note.MaxLength}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="200"
                                 AutomationProperties.Name="{x:Static loc:Strings.PropertiesNote}" LostFocus="NoteBox_LostFocus" />
                    </StackPanel>

                    <!-- A note for the several: after each one's own, or in its place -->
                    <StackPanel IsVisible="{Binding IsMulti}" Spacing="6">
                        <TextBlock Text="{x:Static loc:Strings.PropertiesNote}" Classes="propHeader" />
                        <TextBlock Text="{Binding NotesOfTheirOwn}" Classes="propPart" TextWrapping="Wrap"
                                   IsVisible="{Binding NotesOfTheirOwn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBox x:Name="NoteForAllBox" Text="{Binding NoteForAll}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 PlaceholderText="{x:Static loc:Strings.PropertiesNoteForAllPlaceholder}"
                                 AutomationProperties.Name="{x:Static loc:Strings.PropertiesNoteForAllPlaceholder}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AppendNoteButton" Classes="secondary" Padding="12,6" Content="{x:Static loc:Strings.PropertiesNoteAppend}"
                                    Command="{Binding AppendNoteToAllCommand}"
                                    IsEnabled="{Binding NoteForAll, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button x:Name="ReplaceNoteButton" Classes="secondary" Padding="12,6" Content="{x:Static loc:Strings.PropertiesNoteReplace}"
                                    Command="{Binding ReplaceNotesCommand}"
                                    IsEnabled="{Binding NoteForAll, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
