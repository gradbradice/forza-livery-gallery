<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:views="clr-namespace:LiveryGallery.Views"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        xmlns:models="clr-namespace:LiveryGallery.Models"
        x:Class="LiveryGallery.Views.BackupDetailDialog"
        x:DataType="vm:BackupDetailViewModel"
        Width="560" Height="660" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="RemovedLiveryRowTemplate" x:DataType="vm:BackupLiveryRowViewModel">
            <views:LiveryRow />
        </DataTemplate>

        <DataTemplate x:Key="AddedLiveryTemplate" x:DataType="vm:BackupLiveryRowViewModel">
            <views:LiveryRow />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
            <Border IsVisible="{Binding IsFromOtherAccount}" Margin="0,0,0,10" Padding="12,8"
                    CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                    Background="{DynamicResource SurfaceBrush}">
                <TextBlock Text="{Binding OtherAccountNote}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <!-- A backup of the storage: it goes back there, not into the game -->
            <Border IsVisible="{Binding IsStorageBackup}" Margin="0,0,0,10" Padding="12,8"
                    CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource StorageBrush}"
                    Background="{DynamicResource StorageSoftBrush}">
                <TextBlock Text="{x:Static loc:Strings.BackupRestoreIntoStorageNote}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            </StackPanel>

            <TabControl Grid.Row="1" Classes="segments">
                <TabItem Header="{x:Static loc:Strings.BackupRemovedSectionLabel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,10,0,10" IsVisible="{Binding !ShowNoRemovedHint}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Static loc:Strings.ArchiveSelectAllButton}" Classes="secondary"
                                        Padding="10,4" Command="{Binding SelectAllCommand}" />
                                <Button Content="{x:Static loc:Strings.ClearSelectionLabel}" Classes="secondary"
                                        Padding="10,4" Command="{Binding ClearSelectionCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Classes="gutter" IsVisible="{Binding !ShowNoRemovedHint}">
                            <ItemsControl Classes="rowList" ItemsSource="{Binding RemovedRows}"
                                          ItemTemplate="{StaticResource RemovedLiveryRowTemplate}" />
                        </ScrollViewer>

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   IsVisible="{Binding ShowNoRemovedHint}"
                                   Text="{x:Static loc:Strings.BackupNoneRemovedHint}" />

                        <Button x:Name="RestoreButton" Grid.Row="2" Classes="primary" HorizontalAlignment="Right"
                                MinWidth="140" Margin="0,14,0,0" IsVisible="{Binding !ShowNoRemovedHint}"
                                Command="{Binding RestoreSelectedCommand}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{x:Static loc:Strings.BackupAddedSectionLabel}">
                    <Grid>
                        <ScrollViewer Classes="gutter" IsVisible="{Binding !ShowNoAddedHint}" Margin="0,10,0,0">
                            <ItemsControl Classes="rowList" ItemsSource="{Binding AddedEntries}"
                                          ItemTemplate="{StaticResource AddedLiveryTemplate}" />
                        </ScrollViewer>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   IsVisible="{Binding ShowNoAddedHint}"
                                   Text="{x:Static loc:Strings.BackupNoneAddedHint}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
