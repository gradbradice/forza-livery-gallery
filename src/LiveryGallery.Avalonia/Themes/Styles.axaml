<!-- The gallery's own styles; the general ones (buttons, inputs, title bar, tooltips) come from ForzaToolkit.UI.Avalonia -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="Path.menuIcon.installed">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<!-- No car uses it: the installed mark's circle, hollow -->
	<Style Selector="Path.menuIcon.notInstalled">
		<Setter Property="Fill" Value="Transparent" />
		<Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
		<Setter Property="StrokeThickness" Value="1.4" />
	</Style>
	<Style Selector="PathIcon.menuIcon.mine">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>

	<Style Selector="MenuItem.separateOption:disabled">
		<Style Selector="^ TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
		<Style Selector="^ Path.menuIcon">
			<Setter Property="Fill" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
		<Style Selector="^ PathIcon.menuIcon">
			<Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
	</Style>

	<Style Selector="Button.tagEdit">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.rowLink">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>
	<Style Selector="Button.rowLink:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	
	<Style Selector="Button.tagEdit:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.tagEdit:pointerover">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>

	<Style Selector="Button.cardIconButton">
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<!-- The icon of a round card button, centred by the shape itself. A path with a fixed Width and Height draws a
	     Uniform shape from the top-left corner of that box, so a narrow icon (the bookmark) sat to the left and a flat
	     one high. With only a maximum the path takes the size of the shape scaled into 14 x 14, and that box is what
	     the button centres. Without layout rounding of the path the centre is exact, not half a pixel aside -->
	<Style Selector="Button.cardIconButton Path">
		<Setter Property="MaxWidth" Value="14" />
		<Setter Property="MaxHeight" Value="14" />
		<Setter Property="Stretch" Value="Uniform" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="UseLayoutRounding" Value="False" />
	</Style>
	<Style Selector="Button.cardIconButton.view3d:disabled">
		<Setter Property="Opacity" Value="0.4" />
		<Setter Property="Cursor" Value="Arrow" />
	</Style>
	<Style Selector="Button.cardIconButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<!-- A locked livery: the lock button filled with the accent colour, seen from afar like the gold star -->
	<Style Selector="Button.cardIconButton.locked /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.cardIconButton.locked:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
	</Style>

	<Style Selector="Border.liveryCard">
		<Setter Property="Background" Value="{DynamicResource CardBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Border.liveryCard:pointerover">
		<Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Border.liveryCard.selected">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="BoxShadow" Value="0 0 0 2 #6366F1" />
	</Style>
	<!-- The cursor of the keys (the arrows): a ring outside the card, grey round a card not selected, a second ring
	     round a selected one -->
	<Style Selector="Border.liveryCard.current">
		<Setter Property="BoxShadow" Value="0 0 0 2 #94A3B8" />
	</Style>
	<Style Selector="Border.liveryCard.current.selected">
		<Setter Property="BoxShadow" Value="0 0 0 2 #6366F1, 0 0 0 4 #94A3B8" />
	</Style>

	<!-- The icon at the start of a line of the card (country, car type, author, date): a 12 px square at the same
	     place on every line, with the same gap to the text, so the texts start at one line. The shape inside is
	     scaled to fit the square and centred in it both ways (see the round buttons above for why the path itself has
	     no Width and Height): the narrow person and the flat car share their centre with the flag and the calendar -->
	<Style Selector="Border.cardMetaIcon">
		<Setter Property="Width" Value="12" />
		<Setter Property="Height" Value="12" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.cardMetaIcon > Path">
		<Setter Property="Stretch" Value="Uniform" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="UseLayoutRounding" Value="False" />
		<Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<Style Selector="Border.carChip">
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="7,2" />
	</Style>

	<!-- A chip: the quick filter kinds (toggle buttons) and the tags row (buttons: shown, hidden or off) -->
	<Style Selector=":is(Button).tagChip">
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector=":is(ToggleButton).tagChip:checked, Button.tagChip.shown">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector=":is(Button).tagChip:pointerover:not(:checked):not(.shown):not(.hidden)">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- A hidden tag: struck out, in the danger colour, so it does not read as one that is shown -->
	<Style Selector="Button.tagChip.hidden">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
	</Style>
	<Style Selector="Button.tagChip.hidden TextBlock">
		<Setter Property="TextDecorations" Value="Strikethrough" />
	</Style>

	<!-- The counter of the room in the save (status bar) -->
	<Style Selector="Button.slots Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<Style Selector="Button.slots TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Button.slots.warning Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
	</Style>
	<Style Selector="Button.slots.warning TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Button.slots.full Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
	</Style>
	<Style Selector="Button.slots.full TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style Selector="Ellipse.serverDot">
		<Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.green">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.yellow">
		<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.blue">
		<Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.red">
		<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
	</Style>

	<Style Selector="Button.groupOnly">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Padding" Value="8,3" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="ToggleButton.groupHeader:pointerover Button.groupOnly, Button.groupOnly:focus-visible">
		<Setter Property="Opacity" Value="1" />
	</Style>
	<Style Selector="Button.groupOnly:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<Style Selector="Button.quickFilterChip">
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="Button.quickFilterChip:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
	</Style>

	<Style Selector="Button.tagChipCard">
		<Setter Property="Padding" Value="5,1" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="Button.tagChipCard:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.tagChipCard:pressed">
		<Setter Property="RenderTransform" Value="scale(1)" />
		<Setter Property="Opacity" Value="0.75" />
	</Style>

	<Style Selector="ToggleButton.groupHeader">
		<Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Padding" Value="16,12" />
		<Setter Property="Margin" Value="4,10,4,0" />
		<Setter Property="CornerRadius" Value="10,10,0,0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<Grid ColumnDefinitions="*,Auto">
						<ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
						<Path x:Name="PART_Chevron" Grid.Column="1" Data="{DynamicResource IconChevronDown}"
                              Width="10" Height="6" Stretch="Uniform" Margin="12,0,0,0"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="ToggleButton.groupHeader:checked /template/ Path#PART_Chevron">
		<Setter Property="RenderTransform" Value="rotate(180deg)" />
	</Style>
	<Style Selector="ToggleButton.groupHeader:unchecked">
		<Setter Property="Margin" Value="4,10,4,4" />
		<Setter Property="CornerRadius" Value="10" />
	</Style>
	<Style Selector="ToggleButton.groupHeader:pressed">
		<Setter Property="RenderTransform" Value="scale(1)" />
	</Style>
	<Style Selector="Border.galleryRow">
		<Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}" />
		<Setter Property="Margin" Value="4,0" />
	</Style>
	<Style Selector="Border.galleryRow.last">
		<Setter Property="Margin" Value="4,0,4,4" />
		<Setter Property="CornerRadius" Value="0,0,10,10" />
	</Style>
	<Style Selector="Button.langItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.langItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<!-- The scroll bars have their own column (ForzaToolkit.UI.Avalonia's styles). "edge": a list that fills a dialog
	     moves its bar into the dialog's margin; "gutter": a list inside a panel keeps a little room before the bar -->
	<Style Selector="ScrollViewer.edge">
		<Setter Property="Margin" Value="0,0,-12,0" />
		<Setter Property="Padding" Value="0,0,4,0" />
	</Style>
	<Style Selector="ScrollViewer.gutter">
		<Setter Property="Padding" Value="0,0,4,0" />
	</Style>

	<!-- A key of the keyboard (Border.keyCap) in tooltips and in the list of keys (F1): ForzaToolkit.UI.Avalonia's style -->
	<!-- The key of a menu item, right of its text -->
	<Style Selector="TextBlock.menuGesture">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="28,0,0,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<!-- A half of the "Liveries | Screenshots" switch by the search: the chosen half in the accent -->
	<!-- The collections (the albums of the screenshots, later the storage): the halves of a smaller switch, a group's fold
	     arrow, the side panel's rows, a screenshot tile's frame -->
	<Style Selector="Button.viewHalf.compact">
		<Setter Property="Height" Value="26" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Border.groupFold">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Path.folded">
		<Setter Property="RenderTransform" Value="rotate(-90deg)" />
	</Style>
	<Style Selector="Button.sidebarRow">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1.5" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow TextBlock.count">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.selected">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Button.sidebarRow.selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.selected TextBlock.count">
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
	</Style>
	<Style Selector="Border.insertLine">
		<Setter Property="Height" Value="2" />
		<Setter Property="Margin" Value="6,1" />
		<Setter Property="CornerRadius" Value="1" />
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.drop">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- The storage's folders: the folder shown and the one a livery is dragged over in the storage's cyan -->
	<Style Selector=".storage Button.sidebarRow.selected">
		<Setter Property="Background" Value="{DynamicResource StorageSoftBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageSoftBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.selected TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.drop">
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector=".storage Border.insertLine">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.albumChip">
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Padding" Value="8,2" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Border.shotFrame">
		<Setter Property="BorderThickness" Value="2.5" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>
	<Style Selector="Border.shotTile:pointerover Border.shotFrame">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
	</Style>
	<Style Selector="Border.shotTile.selected Border.shotFrame">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- The cursor of the keys, as on the cards: a grey ring outside the picture, a second ring round a selected one -->
	<Style Selector="Border.shotTile.current Border.shotFrame">
		<Setter Property="BoxShadow" Value="0 0 0 2 #94A3B8" />
	</Style>
	<Style Selector="Border.shotTile.current.selected Border.shotFrame">
		<Setter Property="BoxShadow" Value="0 0 0 2 #6366F1, 0 0 0 4 #94A3B8" />
	</Style>

	<!-- A small round button over a picture (the card's and the strip's "game's preview back"). The dark circle is the
	     button's own Border, so the buttons of a card (transparent) do not take it away -->
	<Style Selector="Button.coverReset">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.coverReset:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Button.coverReset > Border">
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Background" Value="#B0000000" />
	</Style>
	<Style Selector="Button.coverReset:pointerover > Border">
		<Setter Property="Background" Value="#E8000000" />
	</Style>

	<Style Selector="Button.viewHalf">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="CornerRadius" Value="7" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.viewHalf.on">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<!-- A text of its own in a half (a count, a label beside an icon): the global TextBlock style would keep it dark -->
	<Style Selector="Button.viewHalf.on TextBlock, Button.modeHalf.on TextBlock">
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.viewHalf.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>

	<!-- The main window's two modes (docs/storage.md): "Game | Storage" in the title bar. The half shown is filled, the
	     game's in the accent, the storage's in its cyan; the count beside the name is a little fainter -->
	<Style Selector="Button.modeHalf">
		<Setter Property="Height" Value="22" />
		<Setter Property="Padding" Value="9,0" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.modeHalf TextBlock.modeCount">
		<Setter Property="Opacity" Value="0.72" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>
	<Style Selector="Button.modeHalf:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>
	<Style Selector="Button.modeHalf.on">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.modeHalf.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.modeHalf.storage.on">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.modeHalf.storage.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="Opacity" Value="0.9" />
	</Style>

	<!-- A stored card: "To the game" filled with the storage's cyan, the mark of a selected card and its frame in it -->
	<Style Selector="Button.cardIconButton.toGame /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.cardIconButton.toGame:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="Opacity" Value="0.88" />
	</Style>
	<Style Selector="Border.selectMark">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Window.storageMode Border.selectMark">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Window.storageMode Border.liveryCard:pointerover">
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Window.storageMode Border.liveryCard.selected">
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
		<Setter Property="BoxShadow" Value="0 0 0 2 #0E7490" />
	</Style>
	<Style Selector="Window.storageMode Border.liveryCard.current.selected">
		<Setter Property="BoxShadow" Value="0 0 0 2 #0E7490, 0 0 0 4 #94A3B8" />
	</Style>

	<!-- "Return to the game" with too little room: the line of the room, a way to choose (in cyan when chosen), the list
	     of the game's liveries that make room, and the button in the storage's colour -->
	<Style Selector="Border.roomInfo">
		<Setter Property="Background" Value="#22F5A524" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="12,9" />
	</Style>
	<Style Selector="Border.roomOption">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="14,10" />
	</Style>
	<Style Selector="Border.roomOption.on">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Border.roomOption:disabled">
		<Setter Property="Opacity" Value="0.6" />
	</Style>
	<Style Selector="TextBlock.roomNote">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Margin" Value="28,0,0,0" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Border.swapList">
		<Setter Property="Margin" Value="28,4,0,0" />
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="10,8" />
	</Style>
	<Style Selector="Border.swapRow">
		<Setter Property="Padding" Value="2,3" />
	</Style>
	<Style Selector="Button.primary.storage">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.primary.storage:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="Opacity" Value="0.9" />
	</Style>

	<!-- Tabs drawn as the gallery's switches ("Liveries | Screenshots"): the halves of one rounded box, the chosen one in
	     the accent. For the windows that compare two lists (a backup, the changes since the last launch) -->
	<Style Selector="TabControl.segments">
		<Setter Property="Padding" Value="0" />
		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<StackPanel Orientation="Horizontal" Spacing="2" />
			</ItemsPanelTemplate>
		</Setter>
		<Setter Property="Template">
			<ControlTemplate>
				<DockPanel>
					<Border DockPanel.Dock="Top" HorizontalAlignment="Left" Height="38" Padding="3" CornerRadius="10" BorderThickness="1"
							Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}">
						<ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
					</Border>
					<ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
									  Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
				</DockPanel>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="TabControl.segments TabItem">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Height="30" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="{TemplateBinding Background}">
					<ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
									  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
									  Foreground="{TemplateBinding Foreground}" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="TabControl.segments TabItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="TabControl.segments TabItem:selected">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="TabControl.segments TabItem:selected:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
	</Style>
</Styles>
