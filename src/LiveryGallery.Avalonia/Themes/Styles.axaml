<!-- The gallery's own styles; the general ones (buttons, inputs, title bar, tooltips) come from ForzaToolkit.UI.Avalonia -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ForzaToolkit.UI.Controls;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:views="clr-namespace:LiveryGallery.Views">

	<!-- The looks of a livery card's own buttons and frames (Views/CardParts.cs) -->
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://LiveryGallery.Avalonia/Themes/CardThemes.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<Style Selector="Path.menuIcon.installed">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<!-- No car uses it: the installed mark's circle, hollow -->
	<Style Selector="Path.menuIcon.notInstalled">
		<Setter Property="Fill" Value="Transparent" />
		<Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
		<Setter Property="StrokeThickness" Value="1.4" />
	</Style>
	<Style Selector="PathIcon.menuIcon.mine">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>

	<!-- A badge in the filter menu: the card's look, 18 on the menu's surface -->
	<Style Selector="views|BadgeChip.menuBadge">
		<Setter Property="ChipSize" Value="18" />
		<Setter Property="Shadow" Value="False" />
		<Setter Property="Surface" Value="MenuFlyoutPresenterBackground" />
		<Setter Property="Margin" Value="0,0,8,0" />
	</Style>
	<Style Selector="views|BadgePair.menuBadge">
		<Setter Property="Margin" Value="0,0,8,0" />
	</Style>
	<!-- The favourites' star in a choice of the menu: in a badge's place, as big as one, the texts after it in one column -->
	<Style Selector="Panel.menuStar">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
		<Setter Property="Margin" Value="0,0,8,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Panel.menuStar > ui|FavoriteStar">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<!-- The place of a badge in a menu row without one: the texts stay in one column -->
	<Style Selector="Border.menuBadgeSpace">
		<Setter Property="Width" Value="18" />
		<Setter Property="Margin" Value="0,0,8,0" />
	</Style>

	<Style Selector="MenuItem.separateOption:disabled">
		<Style Selector="^ TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
		<Style Selector="^ Path.menuIcon">
			<Setter Property="Fill" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
		<Style Selector="^ views|BadgeChip">
			<Setter Property="Opacity" Value="0.4" />
		</Style>
		<Style Selector="^ PathIcon.menuIcon">
			<Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
		</Style>
	</Style>

	<Style Selector="Button.tagEdit">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<!-- The notices' bar over the gallery (MainWindow.axaml, NoticeBanner): news in the accent's soft colour, a warning
	     in amber; its buttons framed in the bar's colour -->
	<Style Selector="Border.noticeBanner">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="Border.noticeBanner.warning">
		<Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
	</Style>
	<Style Selector="Border.noticeBanner Path.noticeIcon">
		<Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
	</Style>
	<Style Selector="Border.noticeBanner.warning Path.noticeIcon">
		<Setter Property="Fill" Value="{x:Null}" />
		<Setter Property="Stroke" Value="{DynamicResource WarningTextBrush}" />
	</Style>
	<Style Selector="Border.noticeBanner.warning TextBlock.noticeTitle">
		<Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
	</Style>
	<Style Selector="Button.noticeAction">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Border.noticeBanner.warning Button.noticeAction">
		<Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
	</Style>
	<Style Selector="Button.noticeIconButton">
		<Setter Property="Width" Value="30" />
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.noticeIconButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.toastUndo">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="ProgressBar.toastTime">
		<Setter Property="Background" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>

	<!-- The properties panel on the right of the gallery (Views/PropertiesPanel.axaml) -->
	<!-- Over the list: a sheet with its own edge and a shadow to set it off from the cards under it -->
	<Style Selector="Border.propertiesPanel">
		<Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="BoxShadow" Value="0 8 28 0 #59000000" />
	</Style>
	<Style Selector="TextBlock.propHeader">
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="TextBlock.propPart">
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<!-- The panel's round buttons, as a card's (CardIconButtonTheme) and the livery window's -->
	<Style Selector="Button.roundIcon">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="16" />
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.roundIcon:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.roundIcon:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>
	<Style Selector="Button.roundIcon.locked /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.roundIcon.locked:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
	</Style>
	<Style Selector="Button.roundIcon.toGame /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.roundIcon.toGame views|ActionGlyph">
		<Setter Property="IconBrush" Value="White" />
	</Style>
	<Style Selector="Border.propTag">
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="CornerRadius" Value="13" />
		<Setter Property="Padding" Value="10,0,4,0" />
		<Setter Property="Height" Value="26" />
	</Style>
	<Style Selector="Border.propTag.part">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Button.propTagText">
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
	</Style>
	<Style Selector="Border.propTag.part Button.propTagText">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.propTagText">
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.propTagText:pointerover /template/ ContentPresenter, Button.propTagText:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Border.propTag.part Button.propTagText:pointerover /template/ ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="Button.propTagRemove">
		<Setter Property="Width" Value="20" />
		<Setter Property="Height" Value="20" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.propTagRemove:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Border.propSuggestions">
		<Setter Property="Background" Value="{DynamicResource CardBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Padding" Value="4" />
		<!-- In a popup over what follows the field (TagEditor): a shadow sets it off from it -->
		<Setter Property="BoxShadow" Value="0 4 14 0 #50000000" />
		<Setter Property="Margin" Value="0,0,0,10" />
	</Style>
	<Style Selector="Button.propSuggestion">
		<Setter Property="Padding" Value="8,5" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.propSuggestion:pointerover /template/ ContentPresenter, Button.propSuggestion:focus-visible /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<!-- The bar over the gallery when several liveries are selected (MainWindow.SelectionBar.cs) -->
	<Style Selector="Border.selectionBar">
		<Setter Property="Background" Value="{DynamicResource CardBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Padding" Value="14,6,6,6" />
		<Setter Property="BoxShadow" Value="0 12 32 0 #55000000" />
	</Style>
	<Style Selector="Button.selectionAction">
		<Setter Property="Height" Value="32" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.selectionAction:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.titleText.on /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<!-- Greyed out when it cannot be done (FH3 to FH5: liveries only shown), its tooltip saying why -->
	<Style Selector="Button.selectionAction:disabled">
		<Setter Property="Opacity" Value="0.4" />
	</Style>
	<Style Selector="Button.selectionAction Path">
		<Setter Property="Width" Value="14" />
		<Setter Property="Height" Value="14" />
		<Setter Property="Stretch" Value="Uniform" />
		<Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="StrokeThickness" Value="1.6" />
		<Setter Property="StrokeLineCap" Value="Round" />
		<Setter Property="StrokeJoin" Value="Round" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- The cards' size in the status bar: three squares, the one of the size shown lit (MainWindow.CardSize.cs) -->
	<Style Selector="Button.cardSize">
		<Setter Property="Width" Value="22" />
		<Setter Property="Height" Value="22" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.cardSize > Border">
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
	</Style>
	<Style Selector="Button.cardSize:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.cardSize.on /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.cardSize.on > Border">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>

	<!-- "Authors" and "Statistics" in the title bar: an icon and a word, no frame -->
	<Style Selector="Button.titleText">
		<Setter Property="Height" Value="28" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="7" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.titleText:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<Style Selector="Button.rowLink">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>
	<Style Selector="Button.rowLink:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	
	<Style Selector="Button.tagEdit:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.tagEdit:pointerover">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
	</Style>




	<!-- A chip: the quick filter kinds (toggle buttons) and the tags row (buttons: shown, hidden or off) -->
	<Style Selector=":is(Button).tagChip">
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector=":is(ToggleButton).tagChip:checked, Button.tagChip.shown">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector=":is(Button).tagChip:pointerover:not(:checked):not(.shown):not(.hidden)">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- A hidden tag: struck out, in the danger colour, so it does not read as one that is shown -->
	<Style Selector="Button.tagChip.hidden">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
	</Style>
	<Style Selector="Button.tagChip.hidden TextBlock">
		<Setter Property="TextDecorations" Value="Strikethrough" />
	</Style>

	<!-- The counter of the room in the save (status bar) -->
	<Style Selector="Button.slots Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<Style Selector="Button.slots TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Button.slots.warning Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
	</Style>
	<Style Selector="Button.slots.warning TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Button.slots.full Ellipse.slotsDot">
		<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
	</Style>
	<Style Selector="Button.slots.full TextBlock.slotsText">
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style Selector="Ellipse.serverDot">
		<Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.green">
		<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.yellow">
		<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.blue">
		<Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Ellipse.serverDot.red">
		<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
	</Style>

	<Style Selector="Button.groupOnly">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Padding" Value="8,3" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="ToggleButton.groupHeader:pointerover Button.groupOnly, Button.groupOnly:focus-visible">
		<Setter Property="Opacity" Value="1" />
	</Style>
	<Style Selector="Button.groupOnly:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<!-- A long list of rows (the archive, the backups, the changes): only the rows in view are made -->
	<Style Selector="ItemsControl.rowList">
		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<VirtualizingStackPanel Orientation="Vertical" />
			</ItemsPanelTemplate>
		</Setter>
	</Style>

	<!-- The chips of the filters: one shape (filterChip), the kinds by their colours. Filled: a filter of the filter
	     menu; outlined: a quick filter (a car, an author), so the two are told apart at a glance; "reset": "Reset
	     filters" at the end, with no fill and no outline, so it reads as an action and not as one more filter -->
	<Style Selector="Button.filterChip">
		<Setter Property="Padding" Value="9,4" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Template">
			<ControlTemplate TargetType="Button">
				<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="Button.filterChip.filled">
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.filterChip.filled:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
	</Style>
	<Style Selector="Button.filterChip.outlined">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.filterChip.outlined:pointerover, Button.filterChip.reset:pointerover">
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
	</Style>
	<Style Selector="Button.filterChip.reset">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Button.filterChip.reset:pointerover">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>


	<!-- A group: no box, a line of its own with a rule to the right (MainWindow.axaml, GroupHeaderTemplate). The cards keep
	     their 8 px margin; the header's text starts where the cards do. The header of the group at the top of the view
	     stays there (VirtualGalleryPanel, "pinned") on the window's background, with a shadow under it -->
	<Style Selector="ToggleButton.groupHeader">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Padding" Value="8,14,8,6" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
				        BoxShadow="{TemplateBinding Tag}">
					<Grid ColumnDefinitions="Auto,*,Auto">
						<ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
						<Border Grid.Column="1" Height="1" Margin="14,0,0,0" VerticalAlignment="Center"
						        Background="{DynamicResource BorderBrush2}" />
						<Path x:Name="PART_Chevron" Grid.Column="2" Data="{DynamicResource IconChevronDown}"
                              Width="10" Height="6" Stretch="Uniform" Margin="12,0,0,0"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="ToggleButton.groupHeader:checked /template/ Path#PART_Chevron">
		<Setter Property="RenderTransform" Value="rotate(180deg)" />
	</Style>
	<Style Selector="ToggleButton.groupHeader:pointerover /template/ Path#PART_Chevron">
		<Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="ToggleButton.groupHeader:pressed">
		<Setter Property="RenderTransform" Value="scale(1)" />
	</Style>
	<Style Selector="ToggleButton.groupHeader.pinned">
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
		<Setter Property="Padding" Value="8,8,8,6" />
		<Setter Property="Tag">
			<BoxShadows>0 6 8 -6 #80000000</BoxShadows>
		</Setter>
	</Style>
	<Style Selector="Border.galleryRow">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Border.galleryRow.last">
		<Setter Property="Margin" Value="0,0,0,10" />
	</Style>
	<Style Selector="Button.langItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.langItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>

	<!-- The scroll bars have their own column (ForzaToolkit.UI.Avalonia's styles). "edge": a list that fills a dialog
	     moves its bar into the dialog's margin; "gutter": a list inside a panel keeps a little room before the bar -->
	<Style Selector="ScrollViewer.edge">
		<Setter Property="Margin" Value="0,0,-12,0" />
		<Setter Property="Padding" Value="0,0,4,0" />
	</Style>
	<Style Selector="ScrollViewer.gutter">
		<Setter Property="Padding" Value="0,0,4,0" />
	</Style>

	<!-- A key of the keyboard (Border.keyCap) in tooltips and in the list of keys (F1): ForzaToolkit.UI.Avalonia's style -->
	<!-- The key of a menu item, right of its text -->
	<Style Selector="TextBlock.menuGesture">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="28,0,0,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<!-- A half of the "Liveries | Screenshots" switch by the search: the chosen half in the accent -->
	<!-- The collections (the albums of the screenshots, later the storage): the halves of a smaller switch, a group's fold
	     arrow, the side panel's rows, a screenshot tile's frame -->
	<Style Selector="Button.viewHalf.compact">
		<Setter Property="Height" Value="26" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Border.groupFold">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Path.folded">
		<Setter Property="RenderTransform" Value="rotate(-90deg)" />
	</Style>
	<Style Selector="Button.sidebarRow">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1.5" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow TextBlock.count">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.selected">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Button.sidebarRow.selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.selected TextBlock.count">
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
	</Style>
	<Style Selector="Border.insertLine">
		<Setter Property="Height" Value="2" />
		<Setter Property="Margin" Value="6,1" />
		<Setter Property="CornerRadius" Value="1" />
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.sidebarRow.drop">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- The storage's folders: the folder shown and the one a livery is dragged over in the storage's cyan -->
	<Style Selector=".storage Button.sidebarRow.selected">
		<Setter Property="Background" Value="{DynamicResource StorageSoftBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageSoftBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.selected TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
	</Style>
	<Style Selector=".storage Button.sidebarRow.drop">
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector=".storage Border.insertLine">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.albumChip">
		<Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Padding" Value="8,2" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<!-- A screenshot's tile (MainWindow.axaml, ScreenshotGroups): rounded, the line under it. In the tiles
	     (MainWindow.ScreenshotLayout.cs, the class "tiles" on ScreenshotsView) the corners are small and there is no line -->
	<Style Selector="Border.shotPicture, Border.shotFrame">
		<Setter Property="CornerRadius" Value="8" />
	</Style>
	<Style Selector="Grid.tiles Border.shotPicture, Grid.tiles Border.shotFrame">
		<Setter Property="CornerRadius" Value="3" />
	</Style>
	<Style Selector="Grid.tiles TextBlock.shotCaption">
		<Setter Property="IsVisible" Value="False" />
	</Style>
	<Style Selector="Border.shotFrame">
		<Setter Property="BorderThickness" Value="2.5" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>
	<Style Selector="Border.shotTile:pointerover Border.shotFrame">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
	</Style>
	<Style Selector="Border.shotTile.selected Border.shotFrame">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<!-- The cursor of the keys, as on the cards: a grey ring outside the picture, a second ring round a selected one -->
	<Style Selector="Border.shotTile.current Border.shotFrame">
		<Setter Property="BoxShadow" Value="0 0 0 2 #94A3B8" />
	</Style>
	<Style Selector="Border.shotTile.current.selected Border.shotFrame">
		<Setter Property="BoxShadow" Value="0 0 0 2 #5B5EF0, 0 0 0 4 #94A3B8" />
	</Style>

	<!-- A small round button over a picture (the card's and the strip's "game's preview back"). The dark circle is the
	     button's own Border, so the buttons of a card (transparent) do not take it away -->
	<Style Selector="Button.coverReset">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.coverReset:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Button.coverReset > Border">
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Background" Value="#B0000000" />
	</Style>
	<Style Selector="Button.coverReset:pointerover > Border">
		<Setter Property="Background" Value="#E8000000" />
	</Style>

	<Style Selector="Button.viewHalf">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="CornerRadius" Value="7" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.viewHalf.on">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<!-- A text of its own in a half (a count, a label beside an icon): the global TextBlock style would keep it dark -->
	<Style Selector="Button.viewHalf.on TextBlock, Button.modeHalf.on TextBlock">
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.viewHalf.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>

	<!-- The main window's two modes (docs/storage.md): "Game | Storage" in the title bar. The half shown is filled, the
	     game's in the accent, the storage's in its cyan; the count beside the name is a little fainter -->
	<Style Selector="Button.modeHalf">
		<Setter Property="Height" Value="22" />
		<Setter Property="Padding" Value="9,0" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.modeHalf TextBlock.modeCount">
		<Setter Property="Opacity" Value="0.72" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>
	<Style Selector="Button.modeHalf:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>
	<Style Selector="Button.modeHalf.on">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.modeHalf.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="Button.modeHalf.storage.on">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.modeHalf.storage.on:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="Opacity" Value="0.9" />
	</Style>


	<!-- "Return to the game" with too little room: the line of the room, a way to choose (in cyan when chosen), the list
	     of the game's liveries that make room, and the button in the storage's colour -->
	<Style Selector="Border.roomInfo">
		<Setter Property="Background" Value="#22F5A524" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="12,9" />
	</Style>
	<Style Selector="Border.roomOption">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="14,10" />
	</Style>
	<Style Selector="Border.roomOption.on">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Border.roomOption:disabled">
		<Setter Property="Opacity" Value="0.6" />
	</Style>
	<Style Selector="TextBlock.roomNote">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Margin" Value="28,0,0,0" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>
	<Style Selector="Border.swapList">
		<Setter Property="Margin" Value="28,4,0,0" />
		<Setter Property="Background" Value="{DynamicResource BgBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="10,8" />
	</Style>
	<Style Selector="Border.swapRow">
		<Setter Property="Padding" Value="2,3" />
	</Style>
	<!-- A secondary button that cannot be used looks so, whatever its colour (the livery window's "Move to the trash") -->
	<Style Selector="Button.secondary:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>
	<Style Selector="Button.primary.storage">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
	</Style>
	<Style Selector="Button.primary.storage:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource StorageBrush}" />
		<Setter Property="Opacity" Value="0.9" />
	</Style>

	<!-- Tabs drawn as the gallery's switches ("Liveries | Screenshots"): the halves of one rounded box, the chosen one in
	     the accent. For the windows that compare two lists (a backup, the changes since the last launch) -->
	<Style Selector="TabControl.segments">
		<Setter Property="Padding" Value="0" />
		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<StackPanel Orientation="Horizontal" Spacing="2" />
			</ItemsPanelTemplate>
		</Setter>
		<Setter Property="Template">
			<ControlTemplate>
				<DockPanel>
					<Border DockPanel.Dock="Top" HorizontalAlignment="Left" Height="38" Padding="3" CornerRadius="10" BorderThickness="1"
							Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}">
						<ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
					</Border>
					<ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
									  Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
				</DockPanel>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="TabControl.segments TabItem">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Height="30" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="{TemplateBinding Background}">
					<ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
									  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
									  Foreground="{TemplateBinding Foreground}" />
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="TabControl.segments TabItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
	</Style>
	<Style Selector="TabControl.segments TabItem:selected">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="TabControl.segments TabItem:selected:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
	</Style>
</Styles>
